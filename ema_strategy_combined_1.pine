//@version=5
strategy("10 EMA Strategy (Combined) - 3% Target / 1% SL", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.05,
     pyramiding=4, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ============================================================
// SHARED HELPERS — used by both the EMA system and the SATS
// system below. TradingView strategies hold one NET position per
// symbol: if EMA and SATS disagree on direction at the same time,
// their orders net against each other (standard Pine behavior).
// When they agree, both entries stack (pyramiding=4) and are still
// tracked/exited independently via their own entry IDs below. Both
// systems use the same default_qty_value (100% of equity) per
// entry, so if they agree in direction simultaneously, combined
// exposure can reach ~200% of equity — lower default_qty_value
// above if that's not desired.
// ============================================================
hasOpenTrade(string id) =>
    bool found = false
    for i = 0 to strategy.opentrades - 1
        if strategy.opentrades.entry_id(i) == id
            found := true
    found

// ============================================================
// INPUTS
// ============================================================
emaLength     = input.int(10, title="EMA Length")
targetPct     = input.float(3.0, title="Take Profit %", step=0.1) / 100
stopPct       = input.float(1.0, title="Stop Loss %", step=0.1) / 100
allowLongs    = input.bool(true, title="Allow Longs")
allowShorts   = input.bool(true, title="Allow Shorts")

useTrendMode  = input.bool(true, title="Use Pullback Mode (recommended for 5-min)",
     tooltip="ON = wait for pullback to EMA + volume confirmation (safer). OFF = simple crossover (more signals, more noise).")
volLookback   = input.int(20, title="Volume Average Lookback")
volMultiplier = input.float(1.2, title="Min Volume vs Average (x)", step=0.1)

useRegressionFilter = input.bool(true, title="Require Linear Regression Prediction Agreement",
     tooltip="Native Pine equivalent of a simple linear regression model predicting next close from current close. Only allow BUY when the prediction points up, only allow SELL when it points down.")
regLookback = input.int(50, title="Regression Lookback (bars)",
     tooltip="Rolling window the regression is fit over (plays the role of the training data in an offline model).")

// ============================================================
// EMA / TREND
// ============================================================
ema10 = ta.ema(close, emaLength)
plot(ema10, title="EMA", color=color.orange, linewidth=2)

// ============================================================
// VOLUME CONFIRMATION (used only in Pullback Mode)
// ============================================================
avgVol = ta.sma(volume, volLookback)
volOK  = volume > avgVol * volMultiplier

// ============================================================
// LINEAR REGRESSION PREDICTION FILTER
// Fits y = a + b*x over the lookback window, where x = previous
// close and y = current close (same setup as an OLS model trained
// on closes[:-1] -> closes[1:]), then predicts the next close from
// today's close. slope = correlation * (stdev_y / stdev_x) is the
// standard OLS slope formula, algebraically identical to what
// LinearRegression().fit() solves for.
// ============================================================
regX = close[1]
regY = close
regCorr  = ta.correlation(regX, regY, regLookback)
regStdX  = ta.stdev(regX, regLookback)
regStdY  = ta.stdev(regY, regLookback)
regSlope = regStdX != 0 ? regCorr * (regStdY / regStdX) : 0.0
regIntercept = ta.sma(regY, regLookback) - regSlope * ta.sma(regX, regLookback)
predictedNextClose = regIntercept + regSlope * close
predictedUp = predictedNextClose > close

plot(predictedNextClose, title="Predicted Next Close", color=color.purple, style=plot.style_circles)

// ============================================================
// ENTRY LOGIC — switches based on useTrendMode
// ============================================================
// Mode A: Simple Crossover
crossLong  = ta.crossover(close, ema10)
crossShort = ta.crossunder(close, ema10)

// Mode B: Pullback + Reversal Candle + Volume
touchedBelowLong  = low <= ema10
bullishCandle     = close > open
pullbackLong      = touchedBelowLong and close > ema10 and bullishCandle and volOK

touchedAboveShort = high >= ema10
bearishCandle     = close < open
pullbackShort     = touchedAboveShort and close < ema10 and bearishCandle and volOK

longCondition  = (useTrendMode ? pullbackLong  : crossLong)  and (not useRegressionFilter or predictedUp)
shortCondition = (useTrendMode ? pullbackShort : crossShort) and (not useRegressionFilter or not predictedUp)

// ============================================================
// STRATEGY EXECUTION — simulated in the Strategy Tester
// ============================================================
var float emaLongEntryPx  = na
var float emaShortEntryPx = na

if allowLongs and longCondition and not hasOpenTrade("EMA Long")
    strategy.entry("EMA Long", strategy.long)
    emaLongEntryPx := close

if allowShorts and shortCondition and not hasOpenTrade("EMA Short")
    strategy.entry("EMA Short", strategy.short)
    emaShortEntryPx := close

// ============================================================
// ALERTS — create an alert on this script using condition
// "Any alert() function call" if you want to be notified and
// trade manually elsewhere. (alertcondition() does not fire
// inside strategy scripts, so alert() is used instead.)
// ============================================================
if longCondition and allowLongs
    alert("BUY signal on " + syminfo.ticker + " — Buy Price: " + str.tostring(close, format.mintick) +
         ". EMA10 pullback/crossover confirmed. Prediction: Price will go up. Review and execute manually.", alert.freq_once_per_bar)

if shortCondition and allowShorts
    alert("SELL signal on " + syminfo.ticker + " — Sell Price: " + str.tostring(close, format.mintick) +
         ". EMA10 pullback/crossover confirmed. Prediction: Price will go down. Review and execute manually.", alert.freq_once_per_bar)

// ============================================================
// EXIT LOGIC — fixed 1% Target / 0.5% Stop
// ============================================================
if hasOpenTrade("EMA Long")
    strategy.exit("EMA Long TP/SL", from_entry="EMA Long",
         limit=emaLongEntryPx * (1 + targetPct), stop=emaLongEntryPx * (1 - stopPct))

if hasOpenTrade("EMA Short")
    strategy.exit("EMA Short TP/SL", from_entry="EMA Short",
         limit=emaShortEntryPx * (1 - targetPct), stop=emaShortEntryPx * (1 + stopPct))

// ============================================================
// VISUALS
// ============================================================
plotshape(longCondition, title="Long Entry", location=location.belowbar,
     color=color.green, style=shape.triangleup, size=size.small)
plotshape(shortCondition, title="Short Entry", location=location.abovebar,
     color=color.red, style=shape.triangledown, size=size.small)

// Clear text labels: BUY / SELL right on the chart
if longCondition and allowLongs
    label.new(bar_index, low, text="BUY", style=label.style_label_up,
         color=color.green, textcolor=color.white, size=size.small)

if shortCondition and allowShorts
    label.new(bar_index, high, text="SELL", style=label.style_label_down,
         color=color.red, textcolor=color.white, size=size.small)

// Exit labels + alert showing entry/exit price and points gained/lost
if strategy.closedtrades > strategy.closedtrades[1]
    lastIdx = strategy.closedtrades - 1
    tradeProfit = strategy.closedtrades.profit(lastIdx)
    entryPx = strategy.closedtrades.entry_price(lastIdx)
    exitPx = strategy.closedtrades.exit_price(lastIdx)
    closedTradeDir = strategy.closedtrades.size(lastIdx) > 0 ? "Long" : "Short"
    profitText = (tradeProfit >= 0 ? "+" : "") + str.tostring(tradeProfit, "#.##")
    label.new(bar_index, high, text=closedTradeDir + " TP/SL\n" + profitText,
         style=label.style_label_down, color=tradeProfit >= 0 ? color.teal : color.maroon,
         textcolor=color.white, size=size.small)
    alert(closedTradeDir + " trade closed on " + syminfo.ticker +
         " — Buy Price: " + str.tostring(closedTradeDir == "Long" ? entryPx : exitPx, format.mintick) +
         ", Sell Price: " + str.tostring(closedTradeDir == "Long" ? exitPx : entryPx, format.mintick) +
         ", P/L: " + profitText, alert.freq_once_per_bar)

// ============================================================
// CHANDELIER EXIT — visual overlay only, does not affect entries/exits
// Ported from Chandelier Exit (Alex Orekhov / everget), v6 -> v5.
// All variables are "ce"-prefixed to avoid colliding with the EMA
// strategy and Supertrend sections above.
// ============================================================
ceLength               = input.int(22, title="CE: ATR Period", group="Chandelier Exit")
ceMult                 = input.float(3.0, step=0.1, title="CE: ATR Multiplier", group="Chandelier Exit")
ceUseClose             = input.bool(true, title="CE: Use Close Price for Extremums", group="Chandelier Exit")
ceShowLabels           = input.bool(true, title="CE: Show Buy/Sell Labels", group="Chandelier Exit")
ceHighlightState       = input.bool(true, title="CE: Highlight State", group="Chandelier Exit")
ceAwaitBarConfirmation = input.bool(true, title="CE: Await Bar Confirmation", group="Chandelier Exit")

ceAtr = ceMult * ta.atr(ceLength)

ceLongStop = (ceUseClose ? ta.highest(close, ceLength) : ta.highest(ceLength)) - ceAtr
ceLongStopPrev = nz(ceLongStop[1], ceLongStop)
ceLongStop := close[1] > ceLongStopPrev ? math.max(ceLongStop, ceLongStopPrev) : ceLongStop

ceShortStop = (ceUseClose ? ta.lowest(close, ceLength) : ta.lowest(ceLength)) + ceAtr
ceShortStopPrev = nz(ceShortStop[1], ceShortStop)
ceShortStop := close[1] < ceShortStopPrev ? math.min(ceShortStop, ceShortStopPrev) : ceShortStop

var int ceDir = 1
ceDir := close > ceShortStopPrev ? 1 : close < ceLongStopPrev ? -1 : ceDir

const color ceTextColor      = color.white
const color ceLongColor      = color.green
const color ceShortColor     = color.red
const color ceLongFillColor  = color.new(color.green, 85)
const color ceShortFillColor = color.new(color.red, 85)

ceBuySignal = ceDir == 1 and ceDir[1] == -1
ceLongStopPlot = plot(ceDir == 1 ? ceLongStop : na, title="CE Long Stop", style=plot.style_linebr, linewidth=2, color=ceLongColor)
plotshape(ceBuySignal ? ceLongStop : na, title="CE Long Stop Start", location=location.absolute, style=shape.circle, size=size.tiny, color=ceLongColor)
plotshape(ceBuySignal and ceShowLabels ? ceLongStop : na, title="CE Buy Label", text="Buy", location=location.absolute, style=shape.labelup, size=size.tiny, color=ceLongColor, textcolor=ceTextColor)

ceSellSignal = ceDir == -1 and ceDir[1] == 1
ceShortStopPlot = plot(ceDir == 1 ? na : ceShortStop, title="CE Short Stop", style=plot.style_linebr, linewidth=2, color=ceShortColor)
plotshape(ceSellSignal ? ceShortStop : na, title="CE Short Stop Start", location=location.absolute, style=shape.circle, size=size.tiny, color=ceShortColor)
plotshape(ceSellSignal and ceShowLabels ? ceShortStop : na, title="CE Sell Label", text="Sell", location=location.absolute, style=shape.labeldown, size=size.tiny, color=ceShortColor, textcolor=ceTextColor)

ceMidPricePlot = plot(ohlc4, title="CE Mid", display=display.none, editable=false)

fill(ceMidPricePlot, ceLongStopPlot, title="CE Long State Filling", color=(ceHighlightState and ceDir == 1 ? ceLongFillColor : na))
fill(ceMidPricePlot, ceShortStopPlot, title="CE Short State Filling", color=(ceHighlightState and ceDir == -1 ? ceShortFillColor : na))

ceAwait = ceAwaitBarConfirmation ? barstate.isconfirmed : true
alertcondition(ceDir != ceDir[1] and ceAwait, title="CE Direction Change", message="Chandelier Exit has changed direction, {{exchange}}:{{ticker}}")
alertcondition(ceBuySignal and ceAwait, title="CE Buy", message="Chandelier Exit Buy, {{exchange}}:{{ticker}}")
alertcondition(ceSellSignal and ceAwait, title="CE Sell", message="Chandelier Exit Sell, {{exchange}}:{{ticker}}")

// ============================================================
// RSI — visual-only value readout, does not affect entries/exits.
// Long-form replica of ta.rsi(close, rsiLength), per the standard
// Wilder RSI formula: RSI = 100 - 100 / (1 + avgGain/avgLoss).
// Shown as a corner table instead of a plotted line, since this
// script is overlay=true and RSI's 0-100 scale can't share a pane
// with price without a separate sub-pane.
// ============================================================
rsiLength = input.int(14, title="RSI: Length", group="RSI")

rsiChange  = ta.change(close)
rsiGain    = rsiChange >= 0 ? rsiChange : 0.0
rsiLoss    = rsiChange < 0 ? (-1) * rsiChange : 0.0
rsiAvgGain = ta.rma(rsiGain, rsiLength)
rsiAvgLoss = ta.rma(rsiLoss, rsiLength)
rsiRS      = rsiAvgGain / rsiAvgLoss
rsiValue   = 100 - (100 / (1 + rsiRS))

var table rsiTable = table.new(position.top_right, 1, 1, border_width=1)
if barstate.islast
    rsiBg = rsiValue > 70 ? color.new(color.red, 20) : rsiValue < 30 ? color.new(color.green, 20) : color.new(color.gray, 40)
    table.cell(rsiTable, 0, 0, "RSI(" + str.tostring(rsiLength) + "): " + str.tostring(rsiValue, "#.##"), bgcolor=rsiBg, text_color=color.white)

// ============================================================
// SELF-AWARE TREND SYSTEM [WillyAlgoTrader] — SATS
// Ported from the standalone "Self-Aware Trend System" indicator
// (v1.12.0) into this strategy. All variables are unprefixed as in
// the original (checked against every EMA/Chandelier/RSI name above
// for collisions — none found). Its own BUY/SELL flips place real
// orders below (SATS Long / SATS Short) alongside the EMA system;
// see the hasOpenTrade() note near the top of this file regarding
// shared net-position behavior when both systems disagree.
// ============================================================

// ---- SATS: constants ----
SATS_GRP_MAIN    = "SATS: Main Settings"
SATS_GRP_ADAPT   = "SATS: Adaptive Engine"
SATS_GRP_TQI     = "SATS: Trend Quality Engine"
SATS_GRP_FILTER  = "SATS: Signal Filters (Display)"
SATS_GRP_RISK    = "SATS: Risk Management"
SATS_GRP_DYN_TP  = "SATS: Dynamic TP Settings"
SATS_GRP_LEARN   = "SATS: Self-Learning"
SATS_GRP_VISUAL  = "SATS: Visual"
SATS_GRP_DASH    = "SATS: Dashboard"
SATS_GRP_ALERT   = "SATS: Alerts"
SATS_GRP_COLORS  = "SATS: Colors"

SATS_VERSION      = "v1.12.0"
WARMUP_FLOOR      = 50
MAX_HISTORY_SIGS  = 100
BYPASS_SCORE      = 12.0
HIT_COLOR_HEX     = #40E0D0
MAX_SCORE_REF     = 100      // 4 factors x 17 + structure 16 + break 16

ER_LOW_THRESH    = 0.25
ER_HIGH_THRESH   = 0.50
VOL_LOW_THRESH   = 0.7
VOL_HIGH_THRESH  = 1.3

EWMA_ALPHA        = 0.2
MULT_SMOOTH_ALPHA = 0.15

// Band geometry — shape of the TQI multiplier and asymmetry limits
TQI_MULT_FLOOR   = 0.6   // band width at perfect quality (TQI = 1)
TQI_MULT_RANGE   = 0.8   // added width at worst quality (TQI = 0)
ASYM_TIGHTEN_MAX = 0.3   // max tightening of the active side at TQI = 1
ASYM_WIDEN_MAX   = 0.4   // max widening of the passive side at TQI = 1

// Grade thresholds (score-based, 0..100 scale)
GRADE_SCORE_APLUS = 80
GRADE_SCORE_A     = 60
GRADE_SCORE_B     = 40

// Grade thresholds (TQI-based, 0..1 scale)
GRADE_TQI_APLUS = 0.70
GRADE_TQI_A     = 0.50
GRADE_TQI_B     = 0.35

// ---- SATS: inputs ----
presetInput      = input.string("Auto", "Preset", options = ["Auto", "Custom", "Scalping", "Default", "Swing", "Crypto 24/7"], group = SATS_GRP_MAIN, tooltip = "Quick presets that override key parameters.")
atrLenInput      = input.int(13, "ATR Length", minval = 5, maxval = 100, group = SATS_GRP_MAIN)
baseMultInput    = input.float(2.0, "Base Band Width (xATR)", minval = 0.5, maxval = 5.0, step = 0.1, group = SATS_GRP_MAIN)
sourceInput      = input.source(close, "Source", group = SATS_GRP_MAIN)

useAdaptiveInput    = input.bool(true, "Enable Vol-Adaptive Bands (legacy ER)", group = SATS_GRP_ADAPT, tooltip = "Legacy linear ER modulation. Kept for backwards compat — TQI Engine below is recommended.")
erLengthInput       = input.int(20, "Efficiency Window", minval = 5, maxval = 100, group = SATS_GRP_ADAPT)
adaptStrengthInput  = input.float(0.5, "Adaptation Strength", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_ADAPT)
atrBaselineLenInput = input.int(100, "ATR Baseline Length", minval = 20, maxval = 500, group = SATS_GRP_ADAPT)

useTqiInput          = input.bool(true, "Enable Trend Quality Engine", group = SATS_GRP_TQI, tooltip = "Master switch. Computes continuous Trend Quality Index (TQI 0..1) each bar from 4 factors. Modulates band width non-linearly.")
qualityStrengthInput = input.float(0.4, "Quality Influence", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_TQI, tooltip = "How aggressively TQI compresses/expands bands. 0 = no effect, 1 = maximum.")
qualityCurveInput    = input.float(1.5, "Quality Curve Power", minval = 1.0, maxval = 3.0, step = 0.1, group = SATS_GRP_TQI, tooltip = "Non-linearity. 1.0 = linear, >1 = bands expand slowly for mild quality drops, rapidly for severe ones.")
multSmoothInput      = input.bool(true, "Smooth Adaptive Multipliers", group = SATS_GRP_TQI, tooltip = "EMA-smooths band multipliers before applying ratchet logic. Prevents compression from sticking. RECOMMENDED ON.")

useAsymBandsInput    = input.bool(true, "Asymmetric Bands", group = SATS_GRP_TQI, tooltip = "Active side (in direction of trend) tightens, passive side widens. Creates ratchet-with-leverage effect in strong trends.")
asymStrengthInput    = input.float(0.5, "Asymmetry Strength", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_TQI)

useEffAtrInput       = input.bool(true, "Efficiency-Weighted ATR", group = SATS_GRP_TQI, tooltip = "Scale ATR by (0.5 + 0.5*ER). Clean trending volatility counts full; noisy volatility is halved.")

useCharFlipInput     = input.bool(true, "Character-Flip Detection", group = SATS_GRP_TQI, tooltip = "Allow SuperTrend to flip on quality collapse, not just price break. TQI must collapse from above High threshold (anywhere within the lookback window) to below Low threshold, with price already moving against the trend.")
charFlipMinAgeInput  = input.int(5, "Char-Flip: Min Trend Age / Window", minval = 1, maxval = 50, group = SATS_GRP_TQI, tooltip = "Minimum bars current trend must hold before char-flip can fire. Also defines the TQI collapse lookback window (min 3 bars).")
charFlipHighInput    = input.float(0.55, "Char-Flip: High TQI", minval = 0.3, maxval = 0.9, step = 0.05, group = SATS_GRP_TQI)
charFlipLowInput     = input.float(0.25, "Char-Flip: Low TQI", minval = 0.0, maxval = 0.5, step = 0.05, group = SATS_GRP_TQI)

tqiWeightErInput     = input.float(0.35, "Weight: Efficiency", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_TQI)
tqiWeightVolInput    = input.float(0.20, "Weight: Volatility Regime", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_TQI)
tqiWeightStructInput = input.float(0.25, "Weight: Structure", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_TQI)
tqiWeightMomInput    = input.float(0.20, "Weight: Momentum Persist", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_TQI)
tqiStructLenInput    = input.int(20, "Structure Window", minval = 5, maxval = 100, group = SATS_GRP_TQI, tooltip = "Lookback for structural price-position calculation.")
tqiMomLenInput       = input.int(10, "Momentum Persist Window", minval = 3, maxval = 50, group = SATS_GRP_TQI)

useStructureInput = input.bool(true, "Use Structure in Score (display)", group = SATS_GRP_FILTER)
pivotLenInput     = input.int(3, "Pivot Strength", minval = 2, maxval = 10, group = SATS_GRP_FILTER)

useRsiInput       = input.bool(true, "Use RSI in Score (display)", group = SATS_GRP_FILTER)
rsiLenInput       = input.int(14, "RSI Length", minval = 5, maxval = 50, group = SATS_GRP_FILTER)
rsiOBInput        = input.int(70, "RSI Overbought", minval = 55, maxval = 90, group = SATS_GRP_FILTER)
rsiOSInput        = input.int(30, "RSI Oversold", minval = 10, maxval = 45, group = SATS_GRP_FILTER)
rsiLookbackInput  = input.int(20, "RSI Memory (bars)", minval = 3, maxval = 100, group = SATS_GRP_FILTER)

useVolInput        = input.bool(true, "Use Volume in Score (display)", group = SATS_GRP_FILTER)
volLenInput        = input.int(20, "Volume Z Window", minval = 5, maxval = 100, group = SATS_GRP_FILTER)

showRiskInput     = input.bool(true, "Show TP/SL Levels", group = SATS_GRP_RISK)
slAtrMultInput    = input.float(1.5, "SL Buffer (xATR)", minval = 0.3, maxval = 5.0, step = 0.1, group = SATS_GRP_RISK)
slMaxDistInput    = input.float(4.0, "Max SL Distance (xATR)", minval = 1.0, maxval = 15.0, step = 0.5, group = SATS_GRP_RISK, tooltip = "Hard cap on stop distance from entry. Protects against stale/far pivots producing oversized risk per trade. The effective cap is never tighter than SL Buffer.")

tpModeInput       = input.string("Fixed", "TP Mode", options = ["Fixed", "Dynamic"], group = SATS_GRP_RISK, tooltip = "Fixed: classic fixed R-multiples.\nDynamic: TP levels adapt to TQI and volatility regime. High TQI + trending = wider targets; low TQI + choppy = tighter targets.")

tp1RInput         = input.float(1.0, "TP1 (R-multiple)", minval = 0.5, maxval = 10.0, step = 0.1, group = SATS_GRP_RISK)
tp2RInput         = input.float(2.0, "TP2 (R-multiple)", minval = 0.5, maxval = 10.0, step = 0.1, group = SATS_GRP_RISK)
tp3RInput         = input.float(3.0, "TP3 (R-multiple)", minval = 0.5, maxval = 10.0, step = 0.1, group = SATS_GRP_RISK)

dynTpTqiWeightInput  = input.float(0.6, "TQI Influence on TP", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_DYN_TP, tooltip = "These settings only apply when TP Mode = Dynamic.\nHow much TQI affects target expansion. 0 = TQI ignored, 1 = full influence.")
dynTpVolWeightInput  = input.float(0.4, "Volatility Influence on TP", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_DYN_TP, tooltip = "How much vol regime affects targets. High vol = wider targets.")
dynTpMinScaleInput   = input.float(0.5, "Min TP Scale", minval = 0.2, maxval = 1.0, step = 0.05, group = SATS_GRP_DYN_TP, tooltip = "Floor multiplier — TPs never shrink below base x this value. Prevents absurdly tight targets in chop.")
dynTpMaxScaleInput   = input.float(2.0, "Max TP Scale", minval = 1.0, maxval = 4.0, step = 0.1, group = SATS_GRP_DYN_TP, tooltip = "Ceiling multiplier — TPs never expand beyond base x this value. Prevents unreachable targets.")
dynTpFloorR1Input    = input.float(0.5, "TP1 Absolute Floor (R)", minval = 0.2, maxval = 2.0, step = 0.1, group = SATS_GRP_DYN_TP, tooltip = "TP1 will never go below this R value regardless of scaling. TP2/TP3 floors scale proportionally and are capped by the absolute ceiling.")
dynTpCeilR3Input     = input.float(8.0, "TP Absolute Ceiling (R)", minval = 2.0, maxval = 20.0, step = 0.5, group = SATS_GRP_DYN_TP, tooltip = "No TP level will ever exceed this R value regardless of scaling.")

labelOffsetInput  = input.int(10, "Label Offset (bars)", minval = 10, maxval = 100, group = SATS_GRP_RISK)
showHitsInput     = input.bool(true, "Mark TP Hits (visual)", group = SATS_GRP_RISK)
tradeMaxAgeInput  = input.int(100, "Trade Timeout (bars)", minval = 10, maxval = 500, group = SATS_GRP_RISK)

useAutoCalibInput  = input.bool(false, "Enable Auto-Calibration (experimental)", group = SATS_GRP_LEARN, tooltip = "EXPERIMENTAL hill-climbing: on poor edge, Quality Influence is shifted by one step; if the previous shift made avgR worse, the direction is reversed. On good edge the search is frozen. Note: changing ANY input fully recalculates the script and resets learning memory.")
calibWindowInput   = input.int(20, "Calibration Window", minval = 5, maxval = 100, group = SATS_GRP_LEARN)
calibBadRInput     = input.float(0.0, "Bad-Edge Threshold (R)", minval = -2.0, maxval = 1.0, step = 0.1, group = SATS_GRP_LEARN)
calibGoodRInput    = input.float(0.7, "Good-Edge Threshold (R)", minval = 0.0, maxval = 5.0, step = 0.1, group = SATS_GRP_LEARN)
calibStepQInput    = input.float(0.05, "Quality Step", minval = 0.01, maxval = 0.3, step = 0.01, group = SATS_GRP_LEARN)
calibCooldownInput = input.int(5, "Calibration Cooldown (signals)", minval = 1, maxval = 50, group = SATS_GRP_LEARN)
calibMinQInput     = input.float(0.1, "Quality Floor", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_LEARN)
calibMaxQInput     = input.float(0.9, "Quality Ceiling", minval = 0.0, maxval = 1.0, step = 0.05, group = SATS_GRP_LEARN)

themeInput          = input.string("Auto", "Theme", options = ["Auto", "Dark", "Light"], group = SATS_GRP_VISUAL)
showBandsInput      = input.bool(true,  "Show SuperTrend Bands", group = SATS_GRP_VISUAL)
showTqiColorInput   = input.bool(true,  "Color Line by TQI", group = SATS_GRP_VISUAL, tooltip = "Line transparency reflects current TQI. Bright = high quality, faded = low quality.")
showSignalsInput    = input.bool(true,  "Show Signal Labels", group = SATS_GRP_VISUAL)
showBgInput         = input.bool(false, "Show Trend Background", group = SATS_GRP_VISUAL)
showWatermarkInput  = input.bool(true,  "Show Watermark", group = SATS_GRP_VISUAL)

showDashInput         = input.bool(true,  "Show Dashboard", group = SATS_GRP_DASH)
showTqiBreakdownInput = input.bool(true,  "Show TQI Breakdown", group = SATS_GRP_DASH)
showBreakdownInput    = input.bool(false, "Show Score Breakdown (legacy)", group = SATS_GRP_DASH)
showPerfInput         = input.bool(true,  "Show Performance Stats", group = SATS_GRP_DASH)
dashPosStr            = input.string("Top Right", "Dashboard Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right", "Middle Right"], group = SATS_GRP_DASH)

bullColorInput    = input.color(#00E676, "Bull", inline = "sc1", group = SATS_GRP_COLORS)
bearColorInput    = input.color(#FF5252, "Bear", inline = "sc1", group = SATS_GRP_COLORS)
slColorInput      = input.color(#FF1744, "SL",   inline = "sc2", group = SATS_GRP_COLORS)
tpColorInput      = input.color(#00E676, "TP",   inline = "sc2", group = SATS_GRP_COLORS)

enableAlertsInput = input.bool(true, "Enable Alert Signals", group = SATS_GRP_ALERT)
webhookInput      = input.bool(false, "Webhook JSON Format", group = SATS_GRP_ALERT, tooltip = "Applies to combined alert() calls only.\nThe individual alertcondition() alerts (Buy/Sell variants, TP/SL events, timeout, flip-exit, char-flip)\nuse the message you type into the TradingView alert dialog.")

// ---- SATS: preset resolution + TP order fix ----
int tfMinutes = timeframe.in_seconds(timeframe.period) / 60

string resolvedPreset = presetInput
if presetInput == "Auto"
    resolvedPreset := tfMinutes <= 5 ? "Scalping" : (tfMinutes <= 240 ? "Default" : "Swing")

int   effectiveAtrLen   = switch resolvedPreset
    "Scalping"    => 10
    "Default"     => 14
    "Swing"       => 21
    "Crypto 24/7" => 14
    "Custom"      => atrLenInput
    => atrLenInput

float effectiveBaseMult = switch resolvedPreset
    "Scalping"    => 1.5
    "Default"     => 2.0
    "Swing"       => 2.5
    "Crypto 24/7" => 2.8
    "Custom"      => baseMultInput
    => baseMultInput

int   effectiveErLen    = switch resolvedPreset
    "Scalping"    => 14
    "Default"     => 20
    "Swing"       => 30
    "Crypto 24/7" => 20
    "Custom"      => erLengthInput
    => erLengthInput

int   effectiveRsiLen   = switch resolvedPreset
    "Scalping"    => 9
    "Default"     => 14
    "Swing"       => 21
    "Crypto 24/7" => 14
    "Custom"      => rsiLenInput
    => rsiLenInput

float effectiveSlMult   = switch resolvedPreset
    "Scalping"    => 1.0
    "Default"     => 1.5
    "Swing"       => 2.0
    "Crypto 24/7" => 2.5
    "Custom"      => slAtrMultInput
    => slAtrMultInput

float fixedTp1R = math.min(tp1RInput, math.min(tp2RInput, tp3RInput))
float fixedTp3R = math.max(tp1RInput, math.max(tp2RInput, tp3RInput))
float fixedTp2R = tp1RInput + tp2RInput + tp3RInput - fixedTp1R - fixedTp3R

// ---- SATS: theme & colors ----
isDark = switch themeInput
    "Dark"  => true
    "Light" => false
    =>         color.r(chart.bg_color) < 128

TEXT_COLOR    = isDark ? #E0E0E0 : #1A1A1A
TEXT_MUTED    = isDark ? color.new(#9E9E9E, 0) : color.new(#757575, 0)
TEXT_BRIGHT   = isDark ? #FFFFFF : #000000
TABLE_BG      = isDark ? color.new(#131722, 5) : color.new(#FFFFFF, 5)
TABLE_BORDER  = isDark ? color.new(#2A2E39, 0) : color.new(#D0D0D0, 0)
TABLE_ROW_ALT = isDark ? color.new(#1C2030, 0) : color.new(#F0F4F8, 0)
HEADER_BG     = color.new(#2962FF, 0)
HEADER_TEXT   = #FFFFFF
LABEL_TEXT    = #FFFFFF
WM_COLOR      = isDark ? color.new(#FFFFFF, 80) : color.new(#000000, 80)

BULL_BG       = color.new(bullColorInput, 92)
BEAR_BG       = color.new(bearColorInput, 92)

NEUTRAL_YELLOW = color.new(#FFEB3B, 0)

HIT_COLOR = color.new(HIT_COLOR_HEX, 0)

// ---- SATS: functions ----
safeDiv(float num, float den, float fallback = 0.0) =>
    den != 0 and not na(num) and not na(den) ? num / den : fallback

clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(hi, v))

clampInt(int v, int lo, int hi) =>
    math.max(lo, math.min(hi, v))

calcEfficiencyRatio(float src, int len) =>
    float change     = math.abs(src - src[len])
    float volatility = math.sum(math.abs(src - src[1]), len)
    safeDiv(change, volatility, 0.0)

calcVolumeZ(int len) =>
    float vMean = ta.sma(volume, len)
    float vStd  = ta.stdev(volume, len)
    safeDiv(volume - vMean, vStd, 0.0)

mapClamp(float v, float inLo, float inHi, float outLo, float outHi) =>
    float t = clamp(safeDiv(v - inLo, inHi - inLo, 0.0), 0.0, 1.0)
    outLo + t * (outHi - outLo)

mapClampInv(float v, float inLo, float inHi, float outHigh, float outLow) =>
    float t = clamp(safeDiv(v - inLo, inHi - inLo, 0.0), 0.0, 1.0)
    outHigh - t * (outHigh - outLow)

getDashPos(string s) =>
    switch s
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        =>                position.middle_right

erBin(float er) =>
    er < ER_LOW_THRESH ? 0 : (er < ER_HIGH_THRESH ? 1 : 2)

volBin(float vRatio) =>
    vRatio < VOL_LOW_THRESH ? 0 : (vRatio < VOL_HIGH_THRESH ? 1 : 2)

cellIdx(int eb, int vb) =>
    eb * 3 + vb

calcRealizedR(bool slHit, bool tp1H, bool tp2H, bool tp3H, float tp1R, float tp2R, float tp3R) =>
    float realizedR = 0.0
    if tp3H
        realizedR := (tp1R + tp2R + tp3R) / 3.0
    else if slHit
        float taken = 0.0
        float remaining = 1.0
        if tp1H
            taken += (1.0 / 3.0) * tp1R
            remaining -= 1.0 / 3.0
        if tp2H
            taken += (1.0 / 3.0) * tp2R
            remaining -= 1.0 / 3.0
        realizedR := taken + remaining * (-1.0)
    realizedR

calcTimeoutR(bool tp1H, bool tp2H, bool tp3H, float tp1R, float tp2R, float tp3R) =>
    float taken = 0.0
    if tp1H
        taken += (1.0 / 3.0) * tp1R
    if tp2H
        taken += (1.0 / 3.0) * tp2R
    if tp3H
        taken += (1.0 / 3.0) * tp3R
    taken

calcDynTpScale(float tqiVal, float volRatioVal, float tqiWeight, float volWeight, float minScale, float maxScale) =>
    float tqiComp = clamp(tqiVal, 0.0, 1.0)
    float volComp = clamp(mapClamp(volRatioVal, 0.5, 2.0, 0.0, 1.0), 0.0, 1.0)
    float wSum    = tqiWeight + volWeight
    float wDenom  = wSum > 0 ? wSum : 1.0
    float rawScale = (tqiComp * tqiWeight + volComp * volWeight) / wDenom
    float finalScale = minScale + rawScale * (maxScale - minScale)
    finalScale

// ---- SATS: self-learning storage ----
var array<float> signalRBuffer = array.new<float>()
var array<int>   gridCount = array.new<int>(9, 0)
var array<float> gridEwmR  = array.new<float>(9, 0.0)

updateGridCell(int idx, float r) =>
    if idx >= 0 and idx < 9
        int   c       = array.get(gridCount, idx) + 1
        float prevEwm = array.get(gridEwmR, idx)
        float newEwm  = c == 1 ? r : prevEwm * (1.0 - EWMA_ALPHA) + r * EWMA_ALPHA
        array.set(gridCount, idx, c)
        array.set(gridEwmR,  idx, newEwm)

calcRollingStats(int window) =>
    int n = array.size(signalRBuffer)
    if n == 0
        [0.0, 0.0, 0.0]
    else
        int startIdx = math.max(0, n - window)
        float sumR = 0.0
        int   wins = 0
        float runningR = 0.0
        float minRun   = 0.0
        for i = startIdx to n - 1
            float r = array.get(signalRBuffer, i)
            sumR += r
            if r > 0
                wins += 1
            runningR += r
            if runningR < minRun
                minRun := runningR
        int   cnt   = n - startIdx
        float winRt = cnt > 0 ? float(wins) / float(cnt) : 0.0
        float avgR  = cnt > 0 ? sumR / float(cnt) : 0.0
        [winRt, avgR, minRun]

getRegimeEdge(int idx) =>
    int   c   = array.get(gridCount, idx)
    float ewm = array.get(gridEwmR,  idx)
    [c, ewm]

type LearnState
    float allTimeRSum      = 0.0
    int   allTimeCount     = 0
    float allTimePeak      = 0.0
    float allTimeTrough    = 0.0
    float allTimeCumR      = 0.0
    int   curWinStreak     = 0
    int   curLossStreak    = 0
    int   maxWinStreak     = 0
    int   maxLossStreak    = 0
    int   signalsSinceCalib = 0
    float effQ             = na
    int   lastShiftDir     = 0
    float avgRAtLastShift  = na

method record(LearnState this, float r, int cIdx) =>
    array.push(signalRBuffer, r)
    while array.size(signalRBuffer) > MAX_HISTORY_SIGS
        array.shift(signalRBuffer)
    this.allTimeRSum  += r
    this.allTimeCount += 1
    this.allTimeCumR  += r
    if this.allTimeCumR > this.allTimePeak
        this.allTimePeak := this.allTimeCumR
    float curDD = this.allTimeCumR - this.allTimePeak
    if curDD < this.allTimeTrough
        this.allTimeTrough := curDD
    if r > 0
        this.curWinStreak  += 1
        this.curLossStreak := 0
        if this.curWinStreak > this.maxWinStreak
            this.maxWinStreak := this.curWinStreak
    else
        this.curLossStreak += 1
        this.curWinStreak  := 0
        if this.curLossStreak > this.maxLossStreak
            this.maxLossStreak := this.curLossStreak
    updateGridCell(cIdx, r)
    this.signalsSinceCalib += 1
    if useAutoCalibInput and array.size(signalRBuffer) >= calibWindowInput and this.signalsSinceCalib >= calibCooldownInput
        int n = array.size(signalRBuffer)
        int startIdx = n - calibWindowInput
        float sumR = 0.0
        for i = startIdx to n - 1
            sumR += array.get(signalRBuffer, i)
        float postAvgR = sumR / float(calibWindowInput)
        if postAvgR < calibBadRInput
            int dir = this.lastShiftDir == 0 ? 1 : (na(this.avgRAtLastShift) or postAvgR >= this.avgRAtLastShift ? this.lastShiftDir : -this.lastShiftDir)
            this.effQ := clamp(this.effQ + dir * calibStepQInput, calibMinQInput, calibMaxQInput)
            this.avgRAtLastShift  := postAvgR
            this.lastShiftDir     := dir
            this.signalsSinceCalib := 0
        else if postAvgR > calibGoodRInput
            this.lastShiftDir      := 0
            this.avgRAtLastShift   := postAvgR
            this.signalsSinceCalib := 0

var LearnState learn = LearnState.new()

// ---- SATS: base calculations ----
int   warmupBars  = math.max(WARMUP_FLOOR, math.max(effectiveAtrLen, math.max(atrBaselineLenInput, math.max(effectiveErLen, math.max(effectiveRsiLen, math.max(rsiLookbackInput, math.max(volLenInput, math.max(pivotLenInput * 2 + 1, math.max(tqiMomLenInput, tqiStructLenInput)))))))) + 10)
bool  isWarmedUp  = bar_index >= warmupBars

float rawAtr      = nz(ta.atr(effectiveAtrLen), 0.0)
float atrBaseline = nz(ta.sma(rawAtr, atrBaselineLenInput), rawAtr)
float volRatio    = safeDiv(rawAtr, atrBaseline, 1.0)

float erValue     = calcEfficiencyRatio(sourceInput, effectiveErLen)

float atrValue = useEffAtrInput ? rawAtr * (0.5 + 0.5 * erValue) : rawAtr

// ---- SATS: trend quality index ----
float tqiEr = clamp(erValue, 0.0, 1.0)

bool hasVolumeNow = not na(volume) and volume > 0
var bool hasVolume = false
if hasVolumeNow and not hasVolume
    hasVolume := true

float volZRaw = calcVolumeZ(volLenInput)
float tqiVol  = hasVolume ? mapClamp(nz(volZRaw, 0.0), -1.0, 2.0, 0.0, 1.0) : mapClamp(volRatio, 0.6, 1.8, 0.0, 1.0)

float structHi = ta.highest(high, tqiStructLenInput)
float structLo = ta.lowest(low,  tqiStructLenInput)
float structRange = structHi - structLo
float pricePos = safeDiv(close - structLo, structRange, 0.5)
float tqiStruct = clamp(math.abs(pricePos - 0.5) * 2.0, 0.0, 1.0)

float windowChange = close - close[tqiMomLenInput]
float upMoves   = nz(math.sum(close > close[1] ? 1.0 : 0.0, tqiMomLenInput), 0.0)
float downMoves = nz(math.sum(close < close[1] ? 1.0 : 0.0, tqiMomLenInput), 0.0)
float tqiMom = windowChange > 0 ? upMoves / tqiMomLenInput : windowChange < 0 ? downMoves / tqiMomLenInput : 0.0

float tqiWeightSum   = tqiWeightErInput + tqiWeightVolInput + tqiWeightStructInput + tqiWeightMomInput
float tqiWeightDenom = tqiWeightSum > 0 ? tqiWeightSum : 1.0
float tqiRaw = useTqiInput ? (tqiEr * tqiWeightErInput + tqiVol * tqiWeightVolInput + tqiStruct * tqiWeightStructInput + tqiMom * tqiWeightMomInput) / tqiWeightDenom : 0.5
float tqi = clamp(tqiRaw, 0.0, 1.0)

// ---- SATS: adaptive multipliers ----
float legacyAdaptFactor = useAdaptiveInput ? (1.0 + adaptStrengthInput * (0.5 - erValue)) : 1.0

if barstate.isfirst
    learn.effQ := qualityStrengthInput
if not useAutoCalibInput
    learn.effQ := qualityStrengthInput
float effectiveQualityStrength = learn.effQ

float qualityDeviation = useTqiInput ? math.pow(1.0 - tqi, qualityCurveInput) : 0.5
float tqiMult = 1.0 - effectiveQualityStrength + effectiveQualityStrength * (TQI_MULT_FLOOR + TQI_MULT_RANGE * qualityDeviation)

float symMult = effectiveBaseMult * legacyAdaptFactor * tqiMult

float activeMultRaw  = symMult
float passiveMultRaw = symMult
if useTqiInput and useAsymBandsInput
    float asymTighten = 1.0 - asymStrengthInput * tqi * ASYM_TIGHTEN_MAX
    float asymWiden   = 1.0 + asymStrengthInput * tqi * ASYM_WIDEN_MAX
    activeMultRaw  := symMult * asymTighten
    passiveMultRaw := symMult * asymWiden

var float activeMultSm  = na
var float passiveMultSm = na
activeMultSm  := na(activeMultSm[1])  ? activeMultRaw  : (multSmoothInput ? activeMultSm[1]  * (1.0 - MULT_SMOOTH_ALPHA) + activeMultRaw  * MULT_SMOOTH_ALPHA : activeMultRaw)
passiveMultSm := na(passiveMultSm[1]) ? passiveMultRaw : (multSmoothInput ? passiveMultSm[1] * (1.0 - MULT_SMOOTH_ALPHA) + passiveMultRaw * MULT_SMOOTH_ALPHA : passiveMultRaw)

float activeMult  = activeMultSm
float passiveMult = passiveMultSm

// ---- SATS: adaptive supertrend (asymmetric-aware) ----
var float lowerBand = na
var float upperBand = na
var int   stTrend   = 1

int prevTrend = na(stTrend[1]) ? 1 : stTrend[1]

float lowerMult = prevTrend == 1 ? activeMult  : passiveMult
float upperMult = prevTrend == 1 ? passiveMult : activeMult

float lowerBandRaw = sourceInput - lowerMult * atrValue
float upperBandRaw = sourceInput + upperMult * atrValue

lowerBand := na(lowerBand[1]) ? lowerBandRaw : (close[1] > lowerBand[1] ? math.max(lowerBandRaw, lowerBand[1]) : lowerBandRaw)
upperBand := na(upperBand[1]) ? upperBandRaw : (close[1] < upperBand[1] ? math.min(upperBandRaw, upperBand[1]) : upperBandRaw)

bool priceFlipUp   = prevTrend == -1 and close > upperBand[1]
bool priceFlipDown = prevTrend ==  1 and close < lowerBand[1]

var int trendStartBar = 0
int trendAge = bar_index - trendStartBar

int   charFlipWindow = math.max(charFlipMinAgeInput, 3)
float tqiWindowHigh  = ta.highest(tqi, charFlipWindow)

bool charFlipCondBase = useCharFlipInput and useTqiInput and trendAge >= charFlipMinAgeInput and tqiWindowHigh > charFlipHighInput and tqi < charFlipLowInput
bool charFlipDown = charFlipCondBase and prevTrend ==  1 and close < close[charFlipWindow]
bool charFlipUp   = charFlipCondBase and prevTrend == -1 and close > close[charFlipWindow]

bool finalFlipUp   = priceFlipUp   or charFlipUp
bool finalFlipDown = priceFlipDown or charFlipDown

stTrend := na(stTrend[1]) ? 1 : (finalFlipUp ? 1 : (finalFlipDown ? -1 : prevTrend))

if stTrend != prevTrend
    trendStartBar := bar_index

float stLine = stTrend == 1 ? lowerBand : upperBand

bool flipUp   = stTrend ==  1 and stTrend[1] == -1
bool flipDown = stTrend == -1 and stTrend[1] ==  1

bool charFlipFiredUp   = charFlipUp   and not priceFlipUp   and flipUp
bool charFlipFiredDown = charFlipDown and not priceFlipDown and flipDown
bool charFlipFired     = charFlipFiredUp or charFlipFiredDown

// ---- SATS: dynamic TP R-multiples ----
bool useDynTp = tpModeInput == "Dynamic"

float dynScale = useDynTp ? calcDynTpScale(tqi, volRatio, dynTpTqiWeightInput, dynTpVolWeightInput, dynTpMinScaleInput, dynTpMaxScaleInput) : 1.0

float tp1Floor = math.min(dynTpFloorR1Input, dynTpCeilR3Input)
float tp2Floor = math.min(dynTpFloorR1Input * (fixedTp2R / math.max(fixedTp1R, 0.01)), dynTpCeilR3Input)
float tp3Floor = math.min(dynTpFloorR1Input * (fixedTp3R / math.max(fixedTp1R, 0.01)), dynTpCeilR3Input)
float effTp1R = useDynTp ? clamp(fixedTp1R * dynScale, tp1Floor, dynTpCeilR3Input) : fixedTp1R
float effTp2R = useDynTp ? clamp(fixedTp2R * dynScale, tp2Floor, dynTpCeilR3Input) : fixedTp2R
float effTp3R = useDynTp ? clamp(fixedTp3R * dynScale, tp3Floor, dynTpCeilR3Input) : fixedTp3R

float liveTp1R = math.min(effTp1R, math.min(effTp2R, effTp3R))
float liveTp3R = math.max(effTp1R, math.max(effTp2R, effTp3R))
float liveTp2R = effTp1R + effTp2R + effTp3R - liveTp1R - liveTp3R

// ---- SATS: legacy display data + signal score ----
float rsiVal    = nz(ta.rsi(close, effectiveRsiLen), 50.0)
float volZ      = hasVolume ? volZRaw : 0.0

float rsiLowestG  = ta.lowest(rsiVal,  rsiLookbackInput)
float rsiHighestG = ta.highest(rsiVal, rsiLookbackInput)

float pivotHigh = ta.pivothigh(high, pivotLenInput, pivotLenInput)
float pivotLow  = ta.pivotlow(low,   pivotLenInput, pivotLenInput)

var float lastPivotHigh = na
var float lastPivotLow  = na

if not na(pivotHigh)
    lastPivotHigh := pivotHigh
if not na(pivotLow)
    lastPivotLow := pivotLow

calcScoreBreakdown(bool isBuy, float rsiLo, float rsiHi) =>
    float dirMove  = isBuy ? close[3] - close : close - close[3]
    float momScore = mapClamp(safeDiv(dirMove, atrValue, 0.0), 0.3, 2.0, 0.0, 17.0)
    float erScore  = mapClamp(erValue, 0.15, 0.7, 0.0, 17.0)
    float vScore   = useVolInput and hasVolume ? mapClamp(volZ, 0.0, 3.0, 0.0, 17.0) : BYPASS_SCORE
    float rsiDepth = isBuy ? math.max(0.0, rsiOSInput - rsiLo) : math.max(0.0, rsiHi - rsiOBInput)
    float rsiScore = useRsiInput ? mapClamp(rsiDepth, 0.0, 15.0, 0.0, 17.0) : BYPASS_SCORE
    float pivDist     = isBuy and not na(lastPivotLow) ? math.abs(close - lastPivotLow) : (not isBuy and not na(lastPivotHigh) ? math.abs(lastPivotHigh - close) : 0.0)
    float structScore = useStructureInput ? mapClampInv(safeDiv(pivDist, atrValue, 0.0), 0.0, 1.5, 16.0, 6.0) : BYPASS_SCORE
    float breakDepth = isBuy ? math.max(0.0, upperBand[1] - close[1]) : math.max(0.0, close[1] - lowerBand[1])
    float breakScore = mapClamp(safeDiv(breakDepth, atrValue, 0.0), 0.0, 1.0, 0.0, 16.0)
    [momScore, erScore, vScore, rsiScore, structScore, breakScore]

[bdMom, bdEr, bdVol, bdRsi, bdStruct, bdBreak] = calcScoreBreakdown(stTrend == 1, rsiLowestG, rsiHighestG)
float bdTotal = bdMom + bdEr + bdVol + bdRsi + bdStruct + bdBreak

// ---- SATS: regime bins ----
int curErBin   = erBin(erValue)
int curVolBin  = volBin(volRatio)
int curCellIdx = cellIdx(curErBin, curVolBin)

// ---- SATS: signal logic ----
float buyScore  = flipUp   ? bdTotal : 0.0
float sellScore = flipDown ? bdTotal : 0.0

bool confirmedBuy  = flipUp   and barstate.isconfirmed and isWarmedUp
bool confirmedSell = flipDown and barstate.isconfirmed and isWarmedUp

// ---- SATS: unified active trade state ----
var int   tradeDir       = 0
var int   tradeEntryBar  = 0
var float tradeEntry     = na
var float tradeSl        = na
var float tradeTp1       = na
var float tradeTp2       = na
var float tradeTp3       = na
var float tradeTp1R      = na
var float tradeTp2R      = na
var float tradeTp3R      = na
var bool  hitTp1         = false
var bool  hitTp2         = false
var bool  hitTp3         = false
var int   tradeCellIdx   = -1

var float lastM = na
var float lastE = na
var float lastV = na
var float lastR = na
var float lastS = na
var float lastB = na
var int   lastDisplaySide = 0
var int   lastSignalBar   = 0

bool slHitFlag    = false
bool timeoutFlag  = false
bool flipExitFlag = false

if (tradeDir == 1 and confirmedSell) or (tradeDir == -1 and confirmedBuy)
    bool  slPierced = tradeDir == 1 ? low <= tradeSl : high >= tradeSl
    float fRisk     = tradeDir == 1 ? tradeEntry - tradeSl : tradeSl - tradeEntry
    float fOpenR    = slPierced ? -1.0 : (tradeDir == 1 ? safeDiv(close - tradeEntry, fRisk) : safeDiv(tradeEntry - close, fRisk))
    float fTp1R     = nz(tradeTp1R, fixedTp1R)
    float fTp2R     = nz(tradeTp2R, fixedTp2R)
    float fTp3R     = nz(tradeTp3R, fixedTp3R)
    float fTaken    = calcTimeoutR(hitTp1, hitTp2, hitTp3, fTp1R, fTp2R, fTp3R)
    float fRem      = 1.0 - (hitTp1 ? 1.0 / 3.0 : 0.0) - (hitTp2 ? 1.0 / 3.0 : 0.0) - (hitTp3 ? 1.0 / 3.0 : 0.0)
    float fR        = clamp(fTaken + fRem * fOpenR, -1.0, fTp3R)
    learn.record(fR, tradeCellIdx)
    flipExitFlag := true
    tradeDir     := 0
    tradeCellIdx := -1
    tradeEntry   := na
    tradeSl      := na

if confirmedBuy
    float tEntry = close
    float slBase = not na(lastPivotLow) ? lastPivotLow : low
    float rawSl  = slBase - effectiveSlMult * atrValue
    float minSl  = tEntry - effectiveSlMult * atrValue
    float tSl    = math.min(rawSl, minSl)
    float slCap  = math.max(slMaxDistInput, effectiveSlMult) * atrValue
    tSl := math.max(tSl, tEntry - slCap)
    float risk   = tEntry - tSl
    tradeDir      := 1
    tradeEntryBar := bar_index
    tradeEntry    := tEntry
    tradeSl       := tSl
    tradeTp1      := tEntry + risk * liveTp1R
    tradeTp2      := tEntry + risk * liveTp2R
    tradeTp3      := tEntry + risk * liveTp3R
    tradeTp1R     := liveTp1R
    tradeTp2R     := liveTp2R
    tradeTp3R     := liveTp3R
    hitTp1        := false
    hitTp2        := false
    hitTp3        := false
    tradeCellIdx  := curCellIdx
    lastM := bdMom
    lastE := bdEr
    lastV := bdVol
    lastR := bdRsi
    lastS := bdStruct
    lastB := bdBreak
    lastDisplaySide := 1
    lastSignalBar   := bar_index
    strategy.entry("SATS Long", strategy.long)

if confirmedSell
    float tEntry = close
    float slBase = not na(lastPivotHigh) ? lastPivotHigh : high
    float rawSl  = slBase + effectiveSlMult * atrValue
    float minSl  = tEntry + effectiveSlMult * atrValue
    float tSl    = math.max(rawSl, minSl)
    float slCap  = math.max(slMaxDistInput, effectiveSlMult) * atrValue
    tSl := math.min(tSl, tEntry + slCap)
    float risk   = tSl - tEntry
    tradeDir      := -1
    tradeEntryBar := bar_index
    tradeEntry    := tEntry
    tradeSl       := tSl
    tradeTp1      := tEntry - risk * liveTp1R
    tradeTp2      := tEntry - risk * liveTp2R
    tradeTp3      := tEntry - risk * liveTp3R
    tradeTp1R     := liveTp1R
    tradeTp2R     := liveTp2R
    tradeTp3R     := liveTp3R
    hitTp1        := false
    hitTp2        := false
    hitTp3        := false
    tradeCellIdx  := curCellIdx
    lastM := bdMom
    lastE := bdEr
    lastV := bdVol
    lastR := bdRsi
    lastS := bdStruct
    lastB := bdBreak
    lastDisplaySide := -1
    lastSignalBar   := bar_index
    strategy.entry("SATS Short", strategy.short)

// ---- SATS: real strategy exits (3-tier scale-out), mirrors tradeTp1/2/3 above ----
if tradeDir == 1
    strategy.exit("SATS Long TP1", from_entry="SATS Long", qty_percent=33, limit=tradeTp1, stop=tradeSl)
    strategy.exit("SATS Long TP2", from_entry="SATS Long", qty_percent=50, limit=tradeTp2, stop=tradeSl)
    strategy.exit("SATS Long TP3", from_entry="SATS Long", qty_percent=100, limit=tradeTp3, stop=tradeSl)

if tradeDir == -1
    strategy.exit("SATS Short TP1", from_entry="SATS Short", qty_percent=33, limit=tradeTp1, stop=tradeSl)
    strategy.exit("SATS Short TP2", from_entry="SATS Short", qty_percent=50, limit=tradeTp2, stop=tradeSl)
    strategy.exit("SATS Short TP3", from_entry="SATS Short", qty_percent=100, limit=tradeTp3, stop=tradeSl)

// ---- SATS: plots ----
int lineTransp = showTqiColorInput and useTqiInput ? clampInt(int(math.round(mapClampInv(tqi, 0.1, 0.9, 70.0, 0.0))), 0, 100) : 0
color stLineColor = stTrend == 1 ? color.new(bullColorInput, lineTransp) : color.new(bearColorInput, lineTransp)

plot(showBandsInput and isWarmedUp ? stLine : na, "SATS SuperTrend", color = stLineColor, linewidth = 2)

bgcolor(showBgInput and isWarmedUp ? (stTrend == 1 ? BULL_BG : BEAR_BG) : na, title = "SATS Trend Background")

// ---- SATS: labels & shapes ----
string scoreRefStr = "/" + str.tostring(MAX_SCORE_REF)
string tpModeTag = useDynTp ? "Dynamic x" + str.tostring(dynScale, "#.00") : "Fixed"

if showSignalsInput and confirmedBuy
    label.new(bar_index, low, "SATS BUY  " + str.tostring(buyScore, "#"), color = bullColorInput, textcolor = LABEL_TEXT, style = label.style_label_up, size = size.small, tooltip = "SATS - BUY\nScore: " + str.tostring(buyScore, "#.0") + scoreRefStr + "\nTQI: " + str.tostring(tqi, "#.00") + "\nER: " + str.tostring(erValue, "#.00") + "\nRSI: " + str.tostring(rsiVal, "#.0") + "\nVol Z: " + str.tostring(volZ, "#.00") + "\nTP Mode: " + tpModeTag + "\nR: " + str.tostring(liveTp1R, "#.0") + "/" + str.tostring(liveTp2R, "#.0") + "/" + str.tostring(liveTp3R, "#.0"))

if showSignalsInput and confirmedSell
    label.new(bar_index, high, "SATS SELL  " + str.tostring(sellScore, "#"), color = bearColorInput, textcolor = LABEL_TEXT, style = label.style_label_down, size = size.small, tooltip = "SATS - SELL\nScore: " + str.tostring(sellScore, "#.0") + scoreRefStr + "\nTQI: " + str.tostring(tqi, "#.00") + "\nER: " + str.tostring(erValue, "#.00") + "\nRSI: " + str.tostring(rsiVal, "#.0") + "\nVol Z: " + str.tostring(volZ, "#.00") + "\nTP Mode: " + tpModeTag + "\nR: " + str.tostring(liveTp1R, "#.0") + "/" + str.tostring(liveTp2R, "#.0") + "/" + str.tostring(liveTp3R, "#.0"))

var line  satsLineEntry = na
var line  satsLineSL    = na
var line  satsLineTp1   = na
var line  satsLineTp2   = na
var line  satsLineTp3   = na
var label satsLbEntry   = na
var label satsLbSL      = na
var label satsLbTp1     = na
var label satsLbTp2     = na
var label satsLbTp3     = na

if showRiskInput
    if (confirmedBuy or confirmedSell) and not na(tradeSl)
        line.delete(satsLineEntry)
        line.delete(satsLineSL)
        line.delete(satsLineTp1)
        line.delete(satsLineTp2)
        line.delete(satsLineTp3)
        label.delete(satsLbEntry)
        label.delete(satsLbSL)
        label.delete(satsLbTp1)
        label.delete(satsLbTp2)
        label.delete(satsLbTp3)

        int lineEnd  = bar_index + labelOffsetInput
        int labelPos = bar_index + labelOffsetInput + 2

        string tp1Lbl = "TP1 " + str.tostring(tradeTp1, format.mintick) + (useDynTp ? " (" + str.tostring(tradeTp1R, "#.0") + "R)" : "")
        string tp2Lbl = "TP2 " + str.tostring(tradeTp2, format.mintick) + (useDynTp ? " (" + str.tostring(tradeTp2R, "#.0") + "R)" : "")
        string tp3Lbl = "TP3 " + str.tostring(tradeTp3, format.mintick) + (useDynTp ? " (" + str.tostring(tradeTp3R, "#.0") + "R)" : "")

        satsLineEntry := line.new(bar_index, tradeEntry, lineEnd, tradeEntry, color = color.new(color.gray, 0), width = 2, style = line.style_solid)
        satsLineSL    := line.new(bar_index, tradeSl,    lineEnd, tradeSl,    color = slColorInput,             width = 2, style = line.style_solid)
        satsLineTp1   := line.new(bar_index, tradeTp1,   lineEnd, tradeTp1,   color = tpColorInput,             width = 1, style = line.style_dashed)
        satsLineTp2   := line.new(bar_index, tradeTp2,   lineEnd, tradeTp2,   color = tpColorInput,             width = 1, style = line.style_dashed)
        satsLineTp3   := line.new(bar_index, tradeTp3,   lineEnd, tradeTp3,   color = tpColorInput,             width = 2, style = line.style_dashed)

        satsLbEntry := label.new(labelPos, tradeEntry, "ENTRY " + str.tostring(tradeEntry, format.mintick), color = color.new(color.gray, 60), textcolor = TEXT_BRIGHT, style = label.style_label_left, size = size.small)
        satsLbSL    := label.new(labelPos, tradeSl,    "SL "    + str.tostring(tradeSl,    format.mintick), color = color.new(slColorInput, 60), textcolor = TEXT_BRIGHT, style = label.style_label_left, size = size.small)
        satsLbTp1   := label.new(labelPos, tradeTp1,   tp1Lbl, color = color.new(tpColorInput, 60), textcolor = TEXT_BRIGHT, style = label.style_label_left, size = size.small)
        satsLbTp2   := label.new(labelPos, tradeTp2,   tp2Lbl, color = color.new(tpColorInput, 60), textcolor = TEXT_BRIGHT, style = label.style_label_left, size = size.small)
        satsLbTp3   := label.new(labelPos, tradeTp3,   tp3Lbl, color = color.new(tpColorInput, 60), textcolor = TEXT_BRIGHT, style = label.style_label_left, size = size.small)

    else if tradeDir != 0 and not na(satsLineEntry)
        int newLineEnd  = bar_index + labelOffsetInput
        int newLabelPos = bar_index + labelOffsetInput + 2

        line.set_x2(satsLineEntry, newLineEnd)
        line.set_x2(satsLineSL, newLineEnd)
        line.set_x2(satsLineTp1, newLineEnd)
        line.set_x2(satsLineTp2, newLineEnd)
        line.set_x2(satsLineTp3, newLineEnd)

        label.set_x(satsLbEntry, newLabelPos)
        label.set_x(satsLbSL, newLabelPos)
        label.set_x(satsLbTp1, newLabelPos)
        label.set_x(satsLbTp2, newLabelPos)
        label.set_x(satsLbTp3, newLabelPos)

// ---- SATS: hit detection + learning feedback ----
if tradeDir != 0 and barstate.isconfirmed and not na(tradeEntry) and not na(tradeSl) and bar_index > tradeEntryBar
    bool slHit      = tradeDir ==  1 ? low  <= tradeSl  : high >= tradeSl
    bool tp1Reached = not slHit and (tradeDir == 1 ? high >= tradeTp1 : low <= tradeTp1)
    bool tp2Reached = not slHit and (tradeDir == 1 ? high >= tradeTp2 : low <= tradeTp2)
    bool tp3Reached = not slHit and (tradeDir == 1 ? high >= tradeTp3 : low <= tradeTp3)

    int  tradeAge   = bar_index - tradeEntryBar
    bool timeoutHit = tradeAge >= tradeMaxAgeInput

    if tp1Reached and not hitTp1
        hitTp1 := true
        if showHitsInput and showRiskInput and not na(satsLineTp1)
            line.set_color(satsLineTp1, HIT_COLOR)
            line.set_style(satsLineTp1, line.style_solid)
            label.set_text(satsLbTp1, "TP1 HIT " + str.tostring(tradeTp1, format.mintick))
            label.set_color(satsLbTp1, color.new(HIT_COLOR, 40))

    if tp2Reached and not hitTp2
        hitTp2 := true
        if showHitsInput and showRiskInput and not na(satsLineTp2)
            line.set_color(satsLineTp2, HIT_COLOR)
            line.set_style(satsLineTp2, line.style_solid)
            label.set_text(satsLbTp2, "TP2 HIT " + str.tostring(tradeTp2, format.mintick))
            label.set_color(satsLbTp2, color.new(HIT_COLOR, 40))

    if tp3Reached and not hitTp3
        hitTp3 := true
        if showHitsInput and showRiskInput and not na(satsLineTp3)
            line.set_color(satsLineTp3, HIT_COLOR)
            line.set_style(satsLineTp3, line.style_solid)
            label.set_text(satsLbTp3, "TP3 HIT " + str.tostring(tradeTp3, format.mintick))
            label.set_color(satsLbTp3, color.new(HIT_COLOR, 40))

    if hitTp3 or slHit or timeoutHit
        float useTp1R = nz(tradeTp1R, fixedTp1R)
        float useTp2R = nz(tradeTp2R, fixedTp2R)
        float useTp3R = nz(tradeTp3R, fixedTp3R)

        float realizedR = 0.0
        if slHit
            slHitFlag := true
            realizedR := calcRealizedR(true, hitTp1, hitTp2, false, useTp1R, useTp2R, useTp3R)
        else if hitTp3
            realizedR := calcRealizedR(false, hitTp1, hitTp2, true, useTp1R, useTp2R, useTp3R)
        else
            timeoutFlag := true
            float tRisk  = tradeDir == 1 ? tradeEntry - tradeSl : tradeSl - tradeEntry
            float tOpenR = tradeDir == 1 ? safeDiv(close - tradeEntry, tRisk) : safeDiv(tradeEntry - close, tRisk)
            float tRem   = 1.0 - (hitTp1 ? 1.0 / 3.0 : 0.0) - (hitTp2 ? 1.0 / 3.0 : 0.0)
            realizedR := calcTimeoutR(hitTp1, hitTp2, false, useTp1R, useTp2R, useTp3R) + tRem * tOpenR
            if showRiskInput and not na(satsLbEntry)
                label.set_text(satsLbEntry, "TIMEOUT EXIT @ " + str.tostring(close, format.mintick))
                label.set_color(satsLbEntry, color.new(NEUTRAL_YELLOW, 40))
            if timeoutHit and tradeDir == 1
                strategy.close("SATS Long", comment = "SATS Timeout")
            if timeoutHit and tradeDir == -1
                strategy.close("SATS Short", comment = "SATS Timeout")

        realizedR := clamp(realizedR, -1.0, useTp3R)
        learn.record(realizedR, tradeCellIdx)

        tradeDir     := 0
        tradeCellIdx := -1
        tradeEntry   := na
        tradeSl      := na

// ---- SATS: dashboard ----
if showDashInput and barstate.islast
    var table dashTable = table.new(getDashPos(dashPosStr), 2, 50, bgcolor = TABLE_BG, border_color = TABLE_BORDER, border_width = 1, frame_color = TABLE_BORDER, frame_width = 1)

    [dashWinRate, dashAvgR, dashWindowDD] = calcRollingStats(calibWindowInput)
    [curRegimeCount, curRegimeEdge] = getRegimeEdge(curCellIdx)

    string trendStr  = stTrend == 1 ? "Bullish UP" : "Bearish DOWN"
    color  trendCol  = stTrend == 1 ? bullColorInput : bearColorInput

    string signalStr = confirmedBuy ? "BUY" : (confirmedSell ? "SELL" : "-")
    color  signalCol = confirmedBuy ? bullColorInput : (confirmedSell ? bearColorInput : TEXT_MUTED)

    string regimeStr = erValue >= ER_HIGH_THRESH ? "Trending" : (erValue >= ER_LOW_THRESH ? "Mixed" : "Choppy")
    color  regimeCol = erValue >= ER_HIGH_THRESH ? bullColorInput : (erValue >= ER_LOW_THRESH ? NEUTRAL_YELLOW : bearColorInput)

    string volRegStr = volRatio < VOL_LOW_THRESH ? "Low Vol" : (volRatio < VOL_HIGH_THRESH ? "Norm Vol" : "High Vol")

    string tqiStr   = useTqiInput ? str.tostring(tqi, "#.00") : "off"
    color  tqiCol   = useTqiInput ? (tqi > 0.6 ? bullColorInput : (tqi > 0.35 ? NEUTRAL_YELLOW : bearColorInput)) : TEXT_MUTED
    string qStrStr  = useTqiInput ? str.tostring(effectiveQualityStrength, "#.00") : "off"
    color  qStrCol  = useTqiInput ? (effectiveQualityStrength > qualityStrengthInput ? NEUTRAL_YELLOW : (effectiveQualityStrength < qualityStrengthInput ? bullColorInput : TEXT_COLOR)) : TEXT_MUTED

    string erStr     = str.tostring(erValue, "#.00")
    string rsiStr    = str.tostring(rsiVal, "#.0")
    string volStr    = hasVolume ? str.tostring(volZ, "#.00") + "z" : "n/a"
    string warmStr   = isWarmedUp ? "Ready" : str.tostring(warmupBars - bar_index) + " bars"

    int    barsAgo  = bar_index - lastSignalBar
    string sideHdr  = lastDisplaySide ==  1 ? "Last: BUY (" + str.tostring(barsAgo) + "b ago)" : (lastDisplaySide == -1 ? "Last: SELL (" + str.tostring(barsAgo) + "b ago)" : "Last: -")
    color  sideCol  = lastDisplaySide ==  1 ? bullColorInput : (lastDisplaySide == -1 ? bearColorInput : TEXT_MUTED)
    bool   hasBreakdown = lastDisplaySide != 0 and showBreakdownInput
    string bdMomStr    = lastDisplaySide != 0 and not na(lastM) ? str.tostring(lastM, "#.0") : "-"
    string bdErStr     = lastDisplaySide != 0 and not na(lastE) ? str.tostring(lastE, "#.0") : "-"
    string bdVolStr    = lastDisplaySide != 0 and not na(lastV) ? str.tostring(lastV, "#.0") : "-"
    string bdRsiStr    = lastDisplaySide != 0 and not na(lastR) ? str.tostring(lastR, "#.0") : "-"
    string bdStructStr = lastDisplaySide != 0 and not na(lastS) ? str.tostring(lastS, "#.0") : "-"
    string bdBreakStr  = lastDisplaySide != 0 and not na(lastB) ? str.tostring(lastB, "#.0") : "-"

    string tqiErStr     = useTqiInput ? str.tostring(tqiEr,     "#.00") : "-"
    string tqiVolStr    = useTqiInput ? str.tostring(tqiVol,    "#.00") : "-"
    string tqiStructStr = useTqiInput ? str.tostring(tqiStruct, "#.00") : "-"
    string tqiMomStr    = useTqiInput ? str.tostring(tqiMom,    "#.00") : "-"

    int    sigCount      = array.size(signalRBuffer)
    string winRateStr    = sigCount == 0 ? "-" : str.tostring(dashWinRate * 100, "#.0") + "%"
    string avgRStr       = sigCount == 0 ? "-" : str.tostring(dashAvgR, "+#.00;-#.00") + "R"
    string winDDStr      = sigCount == 0 ? "-" : str.tostring(dashWindowDD, "#.00") + "R"
    string allDDStr      = learn.allTimeCount == 0 ? "-" : str.tostring(learn.allTimeTrough, "#.00") + "R"
    string streakStr     = learn.allTimeCount == 0 ? "-" : "W:" + str.tostring(learn.curWinStreak) + "/" + str.tostring(learn.maxWinStreak) + " L:" + str.tostring(learn.curLossStreak) + "/" + str.tostring(learn.maxLossStreak)
    string sampleStr     = str.tostring(sigCount) + "/" + str.tostring(MAX_HISTORY_SIGS)
    string regimeEdgeStr = curRegimeCount == 0 ? "-" : str.tostring(curRegimeEdge, "+#.00;-#.00") + "R (" + str.tostring(curRegimeCount) + ")"

    color  winRateCol = sigCount < 5 ? TEXT_MUTED : (dashWinRate >= 0.5 ? bullColorInput : bearColorInput)
    color  avgRCol    = sigCount < 5 ? TEXT_MUTED : (dashAvgR > 0 ? bullColorInput : bearColorInput)
    color  regEdgeCol = curRegimeCount < 5 ? TEXT_MUTED : (curRegimeEdge > 0 ? bullColorInput : bearColorInput)

    string tpModeStr   = useDynTp ? "Dynamic" : "Fixed"
    string dynScaleStr = useDynTp ? "x" + str.tostring(dynScale, "#.00") : "-"
    string liveRStr    = str.tostring(liveTp1R, "#.0") + " / " + str.tostring(liveTp2R, "#.0") + " / " + str.tostring(liveTp3R, "#.0")
    color  tpModeCol   = useDynTp ? (dynScale > 1.2 ? bullColorInput : (dynScale < 0.8 ? bearColorInput : TEXT_COLOR)) : TEXT_COLOR

    table.cell(dashTable, 0, 0, "WillyAlgoTrader", text_color = HEADER_TEXT, bgcolor = HEADER_BG, text_size = size.small, text_halign = text.align_center)
    table.cell(dashTable, 1, 0, "SATS",         text_color = HEADER_TEXT, bgcolor = HEADER_BG, text_size = size.small, text_halign = text.align_center)

    table.cell(dashTable, 0, 1, "Preset",  text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
    table.cell(dashTable, 1, 1, resolvedPreset, text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_ROW_ALT)

    table.cell(dashTable, 0, 2, "Trend",   text_color = TEXT_MUTED, text_size = size.small)
    table.cell(dashTable, 1, 2, trendStr,  text_color = trendCol,   text_size = size.small)

    table.cell(dashTable, 0, 3, "TQI",     text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
    table.cell(dashTable, 1, 3, tqiStr,    text_color = tqiCol,     text_size = size.small, bgcolor = TABLE_ROW_ALT)

    table.cell(dashTable, 0, 4, "Q.Strength", text_color = TEXT_MUTED, text_size = size.small)
    table.cell(dashTable, 1, 4, qStrStr,      text_color = qStrCol,    text_size = size.small)

    table.cell(dashTable, 0, 5, "Signal",  text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
    table.cell(dashTable, 1, 5, signalStr, text_color = signalCol,  text_size = size.small, bgcolor = TABLE_ROW_ALT)

    table.cell(dashTable, 0, 6, "Regime",  text_color = TEXT_MUTED, text_size = size.small)
    table.cell(dashTable, 1, 6, regimeStr + " / " + volRegStr, text_color = regimeCol, text_size = size.small)

    table.cell(dashTable, 0, 7, "ER",      text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
    table.cell(dashTable, 1, 7, erStr,     text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_ROW_ALT)

    table.cell(dashTable, 0, 8, "RSI",     text_color = TEXT_MUTED, text_size = size.small)
    table.cell(dashTable, 1, 8, rsiStr,    text_color = TEXT_COLOR, text_size = size.small)

    table.cell(dashTable, 0, 9, "Vol Z",   text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
    table.cell(dashTable, 1, 9, volStr,    text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_ROW_ALT)

    table.cell(dashTable, 0, 10, "TP Mode",  text_color = TEXT_MUTED, text_size = size.small)
    table.cell(dashTable, 1, 10, tpModeStr,  text_color = tpModeCol,  text_size = size.small)

    table.cell(dashTable, 0, 11, "TP Scale",  text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
    table.cell(dashTable, 1, 11, dynScaleStr, text_color = tpModeCol,  text_size = size.small, bgcolor = TABLE_ROW_ALT)

    table.cell(dashTable, 0, 12, "Live R",    text_color = TEXT_MUTED, text_size = size.small)
    table.cell(dashTable, 1, 12, liveRStr,    text_color = TEXT_COLOR, text_size = size.small)

    table.cell(dashTable, 0, 13, "Status",  text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
    table.cell(dashTable, 1, 13, warmStr,   text_color = isWarmedUp ? bullColorInput : NEUTRAL_YELLOW, text_size = size.small, bgcolor = TABLE_ROW_ALT)

    table.cell(dashTable, 0, 14, "Version", text_color = TEXT_MUTED, text_size = size.small)
    table.cell(dashTable, 1, 14, SATS_VERSION, text_color = TEXT_MUTED, text_size = size.small)

    int rowCursor = 15
    if showTqiBreakdownInput and useTqiInput
        table.cell(dashTable, 0, rowCursor, "TQI Components", text_color = HEADER_TEXT, bgcolor = HEADER_BG, text_size = size.small, text_halign = text.align_center)
        table.cell(dashTable, 1, rowCursor, "0..1",           text_color = HEADER_TEXT, bgcolor = HEADER_BG, text_size = size.small, text_halign = text.align_center)
        rowCursor += 1
        table.cell(dashTable, 0, rowCursor, "Efficiency",  text_color = TEXT_MUTED, text_size = size.small)
        table.cell(dashTable, 1, rowCursor, tqiErStr,      text_color = TEXT_COLOR, text_size = size.small)
        rowCursor += 1
        table.cell(dashTable, 0, rowCursor, "Volatility",  text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        table.cell(dashTable, 1, rowCursor, tqiVolStr,     text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        rowCursor += 1
        table.cell(dashTable, 0, rowCursor, "Structure",   text_color = TEXT_MUTED, text_size = size.small)
        table.cell(dashTable, 1, rowCursor, tqiStructStr,  text_color = TEXT_COLOR, text_size = size.small)
        rowCursor += 1
        table.cell(dashTable, 0, rowCursor, "Mom Persist", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        table.cell(dashTable, 1, rowCursor, tqiMomStr,     text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        rowCursor += 1

    if showPerfInput
        table.cell(dashTable, 0, rowCursor, "Performance", text_color = HEADER_TEXT, bgcolor = HEADER_BG, text_size = size.small, text_halign = text.align_center)
        table.cell(dashTable, 1, rowCursor, sampleStr,     text_color = HEADER_TEXT, bgcolor = HEADER_BG, text_size = size.small, text_halign = text.align_center)
        rowCursor += 1

        table.cell(dashTable, 0, rowCursor, "Win Rate",   text_color = TEXT_MUTED, text_size = size.small)
        table.cell(dashTable, 1, rowCursor, winRateStr,   text_color = winRateCol, text_size = size.small)
        rowCursor += 1

        table.cell(dashTable, 0, rowCursor, "Avg R",      text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        table.cell(dashTable, 1, rowCursor, avgRStr,      text_color = avgRCol,    text_size = size.small, bgcolor = TABLE_ROW_ALT)
        rowCursor += 1

        table.cell(dashTable, 0, rowCursor, "Window DD",  text_color = TEXT_MUTED, text_size = size.small)
        table.cell(dashTable, 1, rowCursor, winDDStr,     text_color = sigCount < 5 ? TEXT_MUTED : bearColorInput, text_size = size.small)
        rowCursor += 1

        table.cell(dashTable, 0, rowCursor, "All-Time DD", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        table.cell(dashTable, 1, rowCursor, allDDStr,      text_color = learn.allTimeCount == 0 ? TEXT_MUTED : bearColorInput, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        rowCursor += 1

        table.cell(dashTable, 0, rowCursor, "Streak W/L", text_color = TEXT_MUTED, text_size = size.small)
        table.cell(dashTable, 1, rowCursor, streakStr,    text_color = TEXT_COLOR, text_size = size.small)
        rowCursor += 1

        table.cell(dashTable, 0, rowCursor, "Regime Edge", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        table.cell(dashTable, 1, rowCursor, regimeEdgeStr, text_color = regEdgeCol, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        rowCursor += 1

    if hasBreakdown
        table.cell(dashTable, 0, rowCursor, sideHdr, text_color = sideCol,     bgcolor = HEADER_BG, text_size = size.small, text_halign = text.align_center)
        table.cell(dashTable, 1, rowCursor, "/" + str.tostring(MAX_SCORE_REF), text_color = HEADER_TEXT, bgcolor = HEADER_BG, text_size = size.small, text_halign = text.align_center)
        rowCursor += 1
        table.cell(dashTable, 0, rowCursor, "Momentum",   text_color = TEXT_MUTED, text_size = size.small)
        table.cell(dashTable, 1, rowCursor, bdMomStr,     text_color = TEXT_COLOR, text_size = size.small)
        rowCursor += 1
        table.cell(dashTable, 0, rowCursor, "Efficiency", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        table.cell(dashTable, 1, rowCursor, bdErStr,      text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        rowCursor += 1
        table.cell(dashTable, 0, rowCursor, "Volume",     text_color = TEXT_MUTED, text_size = size.small)
        table.cell(dashTable, 1, rowCursor, bdVolStr,     text_color = TEXT_COLOR, text_size = size.small)
        rowCursor += 1
        table.cell(dashTable, 0, rowCursor, "RSI Depth",  text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        table.cell(dashTable, 1, rowCursor, bdRsiStr,     text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        rowCursor += 1
        table.cell(dashTable, 0, rowCursor, "Structure",  text_color = TEXT_MUTED, text_size = size.small)
        table.cell(dashTable, 1, rowCursor, bdStructStr,  text_color = TEXT_COLOR, text_size = size.small)
        rowCursor += 1
        table.cell(dashTable, 0, rowCursor, "ST Break",   text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        table.cell(dashTable, 1, rowCursor, bdBreakStr,   text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_ROW_ALT)
        rowCursor += 1

// ---- SATS: watermark ----
if barstate.islast and showWatermarkInput
    var table wmTable = table.new(position.bottom_center, 1, 1, bgcolor = color.new(color.black, 100), border_color = color.new(color.black, 100), border_width = 0, frame_color = color.new(color.black, 100), frame_width = 0)
    table.cell(wmTable, 0, 0, "WillyAlgoTrader", text_color = WM_COLOR, text_size = size.normal, text_halign = text.align_center, bgcolor = color.new(color.black, 100))

// ---- SATS: alerts (combined alert() calls) ----
string tickerStr = syminfo.tickerid
string tfStr     = timeframe.period

if enableAlertsInput and confirmedBuy
    string priceStr      = str.tostring(close, format.mintick)
    string slStrAlert    = str.tostring(tradeSl,  format.mintick)
    string tp1StrAlert   = str.tostring(tradeTp1, format.mintick)
    string tp2StrAlert   = str.tostring(tradeTp2, format.mintick)
    string tp3StrAlert   = str.tostring(tradeTp3, format.mintick)
    string buyScoreStr   = str.tostring(buyScore, "#")
    string tqiAlertStr   = str.tostring(tqi, "#.00")
    string tpModeAlert   = useDynTp ? "dynamic" : "fixed"
    string dynScaleAlert = useDynTp ? str.tostring(dynScale, "#.00") : "1.00"
    string buyJson = '{"action":"buy","ticker":"' + tickerStr + '","tf":"' + tfStr + '","price":' + priceStr + ',"sl":' + slStrAlert + ',"tp1":' + tp1StrAlert + ',"tp2":' + tp2StrAlert + ',"tp3":' + tp3StrAlert + ',"score":' + buyScoreStr + ',"tqi":' + tqiAlertStr + ',"tp_mode":"' + tpModeAlert + '","tp_scale":' + dynScaleAlert + '}'
    string buyText = "SATS BUY | " + tickerStr + " | TF: " + tfStr + " | Price: " + priceStr + " | TQI: " + tqiAlertStr + " | Score: " + buyScoreStr + " | SL: " + slStrAlert + " | TP1: " + tp1StrAlert + " | TP2: " + tp2StrAlert + " | TP3: " + tp3StrAlert + " | TP: " + tpModeAlert + " x" + dynScaleAlert
    alert(webhookInput ? buyJson : buyText, alert.freq_once_per_bar_close)

if enableAlertsInput and confirmedSell
    string priceStr      = str.tostring(close, format.mintick)
    string slStrAlert    = str.tostring(tradeSl,  format.mintick)
    string tp1StrAlert   = str.tostring(tradeTp1, format.mintick)
    string tp2StrAlert   = str.tostring(tradeTp2, format.mintick)
    string tp3StrAlert   = str.tostring(tradeTp3, format.mintick)
    string sellScoreStr  = str.tostring(sellScore, "#")
    string tqiAlertStr   = str.tostring(tqi, "#.00")
    string tpModeAlert   = useDynTp ? "dynamic" : "fixed"
    string dynScaleAlert = useDynTp ? str.tostring(dynScale, "#.00") : "1.00"
    string sellJson = '{"action":"sell","ticker":"' + tickerStr + '","tf":"' + tfStr + '","price":' + priceStr + ',"sl":' + slStrAlert + ',"tp1":' + tp1StrAlert + ',"tp2":' + tp2StrAlert + ',"tp3":' + tp3StrAlert + ',"score":' + sellScoreStr + ',"tqi":' + tqiAlertStr + ',"tp_mode":"' + tpModeAlert + '","tp_scale":' + dynScaleAlert + '}'
    string sellText = "SATS SELL | " + tickerStr + " | TF: " + tfStr + " | Price: " + priceStr + " | TQI: " + tqiAlertStr + " | Score: " + sellScoreStr + " | SL: " + slStrAlert + " | TP1: " + tp1StrAlert + " | TP2: " + tp2StrAlert + " | TP3: " + tp3StrAlert + " | TP: " + tpModeAlert + " x" + dynScaleAlert
    alert(webhookInput ? sellJson : sellText, alert.freq_once_per_bar_close)

bool tp1Event = hitTp1 and not hitTp1[1]
bool tp2Event = hitTp2 and not hitTp2[1]
bool tp3Event = hitTp3 and not hitTp3[1]
bool slEvent  = slHitFlag

if enableAlertsInput and tp1Event
    string p = str.tostring(close, format.mintick)
    string msg = webhookInput ? '{"event":"tp1_hit","ticker":"' + tickerStr + '","tf":"' + tfStr + '","price":' + p + '}' : "SATS TP1 HIT | " + tickerStr + " | TF: " + tfStr + " | Price: " + p
    alert(msg, alert.freq_once_per_bar_close)

if enableAlertsInput and tp2Event
    string p = str.tostring(close, format.mintick)
    string msg = webhookInput ? '{"event":"tp2_hit","ticker":"' + tickerStr + '","tf":"' + tfStr + '","price":' + p + '}' : "SATS TP2 HIT | " + tickerStr + " | TF: " + tfStr + " | Price: " + p
    alert(msg, alert.freq_once_per_bar_close)

if enableAlertsInput and tp3Event
    string p = str.tostring(close, format.mintick)
    string msg = webhookInput ? '{"event":"tp3_hit","ticker":"' + tickerStr + '","tf":"' + tfStr + '","price":' + p + '}' : "SATS TP3 HIT | " + tickerStr + " | TF: " + tfStr + " | Price: " + p
    alert(msg, alert.freq_once_per_bar_close)

if enableAlertsInput and slEvent
    string p = str.tostring(close, format.mintick)
    string msg = webhookInput ? '{"event":"sl_hit","ticker":"' + tickerStr + '","tf":"' + tfStr + '","price":' + p + '}' : "SATS SL HIT | " + tickerStr + " | TF: " + tfStr + " | Price: " + p
    alert(msg, alert.freq_once_per_bar_close)

if enableAlertsInput and timeoutFlag
    string p = str.tostring(close, format.mintick)
    string msg = webhookInput ? '{"event":"timeout_exit","ticker":"' + tickerStr + '","tf":"' + tfStr + '","price":' + p + '}' : "SATS TIMEOUT EXIT | " + tickerStr + " | TF: " + tfStr + " | Price: " + p
    alert(msg, alert.freq_once_per_bar_close)

if enableAlertsInput and flipExitFlag
    string p = str.tostring(close, format.mintick)
    string msg = webhookInput ? '{"event":"flip_exit","ticker":"' + tickerStr + '","tf":"' + tfStr + '","price":' + p + '}' : "SATS FLIP EXIT | " + tickerStr + " | TF: " + tfStr + " | Price: " + p
    alert(msg, alert.freq_once_per_bar_close)

if enableAlertsInput and charFlipFired and barstate.isconfirmed
    string p = str.tostring(close, format.mintick)
    string dir = charFlipFiredUp ? "BULL" : "BEAR"
    string msg = webhookInput ? '{"event":"char_flip","direction":"' + dir + '","ticker":"' + tickerStr + '","tf":"' + tfStr + '","price":' + p + ',"tqi":' + str.tostring(tqi, "#.00") + '}' : "SATS CHAR-FLIP " + dir + " | " + tickerStr + " | TF: " + tfStr + " | Price: " + p + " | TQI: " + str.tostring(tqi, "#.00")
    alert(msg, alert.freq_once_per_bar_close)

// ---- SATS: alertcondition() individual conditions ----
alertcondition(confirmedBuy,  title = "SATS Buy Signal",  message = "SATS BUY on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(confirmedSell, title = "SATS Sell Signal", message = "SATS SELL on {{ticker}} | TF: {{interval}} | Price: {{close}}")

bool buyScoreAPlus      = confirmedBuy  and buyScore  >= GRADE_SCORE_APLUS
bool sellScoreAPlus     = confirmedSell and sellScore >= GRADE_SCORE_APLUS
bool buyScoreAOrBetter  = confirmedBuy  and buyScore  >= GRADE_SCORE_A
bool sellScoreAOrBetter = confirmedSell and sellScore >= GRADE_SCORE_A
bool buyScoreBOrBetter  = confirmedBuy  and buyScore  >= GRADE_SCORE_B
bool sellScoreBOrBetter = confirmedSell and sellScore >= GRADE_SCORE_B

alertcondition(buyScoreAPlus,       title = "SATS Buy Signal (Score A+ only, >=80)",   message = "SATS BUY A+ (score) on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(sellScoreAPlus,      title = "SATS Sell Signal (Score A+ only, >=80)",  message = "SATS SELL A+ (score) on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(buyScoreAOrBetter,   title = "SATS Buy Signal (Score A+ and A, >=60)",  message = "SATS BUY A+/A (score) on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(sellScoreAOrBetter,  title = "SATS Sell Signal (Score A+ and A, >=60)", message = "SATS SELL A+/A (score) on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(buyScoreBOrBetter,   title = "SATS Buy Signal (Score A+/A/B, >=40)",    message = "SATS BUY A+/A/B (score) on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(sellScoreBOrBetter,  title = "SATS Sell Signal (Score A+/A/B, >=40)",   message = "SATS SELL A+/A/B (score) on {{ticker}} | TF: {{interval}} | Price: {{close}}")

bool buyTqiAPlus      = confirmedBuy  and tqi >= GRADE_TQI_APLUS
bool sellTqiAPlus     = confirmedSell and tqi >= GRADE_TQI_APLUS
bool buyTqiAOrBetter  = confirmedBuy  and tqi >= GRADE_TQI_A
bool sellTqiAOrBetter = confirmedSell and tqi >= GRADE_TQI_A
bool buyTqiBOrBetter  = confirmedBuy  and tqi >= GRADE_TQI_B
bool sellTqiBOrBetter = confirmedSell and tqi >= GRADE_TQI_B

alertcondition(buyTqiAPlus,       title = "SATS Buy Signal (TQI A+ only, >=0.70)",   message = "SATS BUY A+ (TQI) on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(sellTqiAPlus,      title = "SATS Sell Signal (TQI A+ only, >=0.70)",  message = "SATS SELL A+ (TQI) on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(buyTqiAOrBetter,   title = "SATS Buy Signal (TQI A+ and A, >=0.50)",  message = "SATS BUY A+/A (TQI) on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(sellTqiAOrBetter,  title = "SATS Sell Signal (TQI A+ and A, >=0.50)", message = "SATS SELL A+/A (TQI) on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(buyTqiBOrBetter,   title = "SATS Buy Signal (TQI A+/A/B, >=0.35)",    message = "SATS BUY A+/A/B (TQI) on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(sellTqiBOrBetter,  title = "SATS Sell Signal (TQI A+/A/B, >=0.35)",   message = "SATS SELL A+/A/B (TQI) on {{ticker}} | TF: {{interval}} | Price: {{close}}")

alertcondition(tp1Event,     title = "SATS TP1 Hit",      message = "SATS TP1 HIT on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(tp2Event,     title = "SATS TP2 Hit",      message = "SATS TP2 HIT on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(tp3Event,     title = "SATS TP3 Hit",      message = "SATS TP3 HIT on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(slEvent,      title = "SATS SL Hit",       message = "SATS SL HIT on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(timeoutFlag,  title = "SATS Timeout Exit",  message = "SATS TIMEOUT EXIT on {{ticker}} | TF: {{interval}} | Price: {{close}}")
alertcondition(flipExitFlag, title = "SATS Flip Exit",    message = "SATS FLIP EXIT on {{ticker}} | TF: {{interval}} | Price: {{close}}")

alertcondition(charFlipFired, title = "SATS Character-Flip", message = "SATS CHAR-FLIP on {{ticker}} | TF: {{interval}} | Price: {{close}} (TQI collapsed)")

alertcondition(confirmedBuy or confirmedSell, title = "SATS Any Signal (Buy or Sell)", message = "SATS Signal on {{ticker}} | TF: {{interval}} | Price: {{close}}")
