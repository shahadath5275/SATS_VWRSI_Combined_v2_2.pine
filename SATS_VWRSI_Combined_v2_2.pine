//@version=5
// ============================================================================
// SATS + VWRSI COMBINED STRATEGY  v2.0.0
// Merge of:
//   - "10 EMA Strategy (Combined)" / Self-Aware Trend System v1.12.0
//   - "Volume Weighted RSI [AlgoAlpha]"
//
// DE-DUPLICATION SUMMARY (what was removed and why):
//   1. THREE separate RSI engines existed (manual Wilder RSI + ta.rsi +
//      AlgoAlpha's VWRSI). Now ONE: the volume-weighted RSI. It feeds the
//      score, the dashboard and the new gate.
//   2. Chandelier Exit removed entirely. It was a second ATR trailing stop
//      with ratchet logic - functionally the same thing the SATS adaptive
//      SuperTrend already does, and it emitted its own competing Buy/Sell
//      labels. Its useful part (trailing) is now an option on the SATS line.
//   3. TWO volume-confirmation paths (SMA-of-volume ratio + volume Z-score)
//      collapsed into ONE z-score based check.
//   4. Standalone RSI corner table removed - folded into the main dashboard.
//   5. All 0-100 scale plots/fills from the VWRSI indicator removed. This is
//      an overlay=true strategy; they cannot share a pane with price. VWRSI
//      is shown in the dashboard instead.
//   6. AR(1) linear-regression "predictor" removed by default (see notes).
//
// BUG FIXES / LOGIC FIXES (see notes at bottom of file):
//   A. Entries are now GATED on trend, TQI, ER, consolidation and regime edge.
//      Previously these were computed, displayed in red on the dashboard, and
//      then completely ignored by the order logic.
//   B. EMA engine and SATS engine no longer fight over one net position.
//   C. process_orders_on_close=true so plotted ENTRY matches the actual fill.
//   D. range_score() integer-division bug ((2/3) evaluated to 0) fixed.
//   E. Optional circuit breaker on consecutive losses / negative regime edge.
// ============================================================================

strategy("SATS + VWRSI Combined v2", overlay = true,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     initial_capital = 10000,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     pyramiding = 0, process_orders_on_close = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// ============================================================================
// GROUP CONSTANTS
// ============================================================================
G_ENGINE  = "1 - Order Engine"
G_GATE    = "2 - Entry Gate (the fix)"
G_MAIN    = "3 - Core Settings"
G_RSI     = "4 - Volume Weighted RSI"
G_TQI     = "5 - Trend Quality Engine"
G_ADAPT   = "6 - Adaptive Bands"
G_EMA     = "7 - EMA Pullback Engine"
G_RISK    = "8 - Risk Management"
G_TPP     = "8b - Take Profit Planner"
G_DYNTP   = "9 - Dynamic TP"
G_LEARN   = "10 - Self-Learning"
G_VISUAL  = "11 - Visual"
G_DASH    = "12 - Dashboard"
G_ALERT   = "13 - Alerts"
G_COLORS  = "14 - Colors"

VERSION           = "v2.2.0"
WARMUP_FLOOR      = 50
MAX_HISTORY_SIGS  = 100
BYPASS_SCORE      = 12.0
HIT_COLOR_HEX     = #40E0D0
MAX_SCORE_REF     = 100

ER_LOW_THRESH     = 0.25
ER_HIGH_THRESH    = 0.50
VOL_LOW_THRESH    = 0.7
VOL_HIGH_THRESH   = 1.3

EWMA_ALPHA        = 0.2
MULT_SMOOTH_ALPHA = 0.15

TQI_MULT_FLOOR    = 0.6
TQI_MULT_RANGE    = 0.8
ASYM_TIGHTEN_MAX  = 0.3
ASYM_WIDEN_MAX    = 0.4

GRADE_SCORE_APLUS = 80
GRADE_SCORE_A     = 60
GRADE_SCORE_B     = 40
GRADE_TQI_APLUS   = 0.70
GRADE_TQI_A       = 0.50
GRADE_TQI_B       = 0.35

// ============================================================================
// INPUTS - ORDER ENGINE
// ============================================================================
engineModeInput = input.string("SATS + EMA filter", "Signal Engine",
     options = ["SATS + EMA filter", "EMA + SATS filter", "SATS only", "EMA only"],
     group = G_ENGINE,
     tooltip = "The old script ran the EMA system and the SATS system as two independent order sources on ONE net position, so they netted against each other. Now one is the trigger and the other is a confirming filter.")

allowLongs  = input.bool(true,  "Allow Longs",  inline = "dir", group = G_ENGINE)
allowShorts = input.bool(true,  "Allow Shorts", inline = "dir", group = G_ENGINE)

// ============================================================================
// INPUTS - ENTRY GATE
// ============================================================================
useGateInput       = input.bool(true, "Enable Entry Gate", group = G_GATE,
     tooltip = "Master switch. OFF reproduces the old ungated behaviour (not recommended).")
gateTrendInput     = input.bool(true, "Block counter-trend entries", group = G_GATE,
     tooltip = "No shorts while the SuperTrend regime is Bullish, no longs while Bearish. This is the single most important filter - the old script printed SHORT arrows while its own dashboard said 'Bullish UP'.")
gateTqiInput       = input.bool(true,  "Require minimum TQI", inline = "gt", group = G_GATE)
gateTqiMinInput    = input.float(0.40, "", minval = 0.0, maxval = 1.0, step = 0.05, inline = "gt", group = G_GATE)
gateErInput        = input.bool(true,  "Require minimum ER", inline = "ge", group = G_GATE)
gateErMinInput     = input.float(0.30, "", minval = 0.0, maxval = 1.0, step = 0.05, inline = "ge", group = G_GATE)
gateChopInput      = input.bool(true,  "Block entries while consolidating", group = G_GATE,
     tooltip = "Uses the VWRSI consolidation-strength measure (ported from the AlgoAlpha indicator). Previously this was drawn as columns and never used for anything.")
gateChopMaxInput   = input.float(0.15, "Max consolidation strength", minval = 0.0, maxval = 1.0, step = 0.05, group = G_GATE)
gateRsiInput       = input.bool(true,  "Require VWRSI agreement", group = G_GATE,
     tooltip = "Long needs VWRSI above midline, short needs VWRSI below.")
gateVolInput       = input.bool(true,  "Require volume confirmation", inline = "gv", group = G_GATE)
gateVolZMinInput   = input.float(0.0,  "", minval = -3.0, maxval = 3.0, step = 0.1, inline = "gv", group = G_GATE)
gateEdgeInput      = input.bool(true,  "Block on negative regime edge", group = G_GATE,
     tooltip = "If this ER/volatility cell has a measured negative expectancy over the minimum sample, stop taking trades in it.")
gateEdgeMinNInput  = input.int(8, "Min samples before edge gate applies", minval = 3, maxval = 50, group = G_GATE)

useBreakerInput    = input.bool(true, "Circuit breaker on loss streak", inline = "cb", group = G_GATE)
breakerLossesInput = input.int(4, "", minval = 2, maxval = 20, inline = "cb", group = G_GATE)
breakerCoolInput   = input.int(10, "Cooldown bars after breaker trips", minval = 1, maxval = 200, group = G_GATE)

// ============================================================================
// INPUTS - CORE
// ============================================================================
presetInput   = input.string("Auto", "Preset", options = ["Auto", "Custom", "Scalping", "Default", "Swing", "Crypto 24/7"], group = G_MAIN)
atrLenInput   = input.int(13, "ATR Length", minval = 5, maxval = 100, group = G_MAIN)
baseMultInput = input.float(2.0, "Base Band Width (xATR)", minval = 0.5, maxval = 5.0, step = 0.1, group = G_MAIN)
sourceInput   = input.source(close, "Source", group = G_MAIN)

// ============================================================================
// INPUTS - VOLUME WEIGHTED RSI  (single RSI for the whole script)
// ============================================================================
rsiLenInput      = input.int(14, "VWRSI Length", minval = 2, maxval = 50, group = G_RSI)
rsiSourceInput   = input.source(close, "VWRSI Source", group = G_RSI)
rsiOBInput       = input.int(70, "Overbought", minval = 55, maxval = 90, inline = "ob", group = G_RSI)
rsiOSInput       = input.int(30, "Oversold",   minval = 10, maxval = 45, inline = "ob", group = G_RSI)
rsiLookbackInput = input.int(20, "RSI Memory (bars)", minval = 3, maxval = 100, group = G_RSI)
rangeLenInput    = input.int(10, "Consolidation Detection Length", minval = 2, maxval = 50, group = G_RSI)
useRsiMaInput    = input.bool(true, "Enable VWRSI MA", inline = "rma", group = G_RSI)
rsiMaTypeInput   = input.string("EMA", "", options = ["EMA", "SMA", "HMA", "SMMA (RMA)", "WMA", "VWMA"], inline = "rma", group = G_RSI)
rsiMaLenInput    = input.int(14, "VWRSI MA Length", minval = 2, maxval = 100, group = G_RSI)

// ============================================================================
// INPUTS - TQI
// ============================================================================
useTqiInput          = input.bool(true, "Enable Trend Quality Engine", group = G_TQI)
qualityStrengthInput = input.float(0.4, "Quality Influence", minval = 0.0, maxval = 1.0, step = 0.05, group = G_TQI)
qualityCurveInput    = input.float(1.5, "Quality Curve Power", minval = 1.0, maxval = 3.0, step = 0.1, group = G_TQI)
multSmoothInput      = input.bool(true, "Smooth Adaptive Multipliers", group = G_TQI)
useAsymBandsInput    = input.bool(true, "Asymmetric Bands", group = G_TQI)
asymStrengthInput    = input.float(0.5, "Asymmetry Strength", minval = 0.0, maxval = 1.0, step = 0.05, group = G_TQI)
useEffAtrInput       = input.bool(true, "Efficiency-Weighted ATR", group = G_TQI)
useCharFlipInput     = input.bool(true, "Character-Flip Detection", group = G_TQI)
charFlipMinAgeInput  = input.int(5, "Char-Flip: Min Trend Age / Window", minval = 1, maxval = 50, group = G_TQI)
charFlipHighInput    = input.float(0.55, "Char-Flip: High TQI", minval = 0.3, maxval = 0.9, step = 0.05, group = G_TQI)
charFlipLowInput     = input.float(0.25, "Char-Flip: Low TQI", minval = 0.0, maxval = 0.5, step = 0.05, group = G_TQI)
tqiWeightErInput     = input.float(0.35, "Weight: Efficiency", minval = 0.0, maxval = 1.0, step = 0.05, group = G_TQI)
tqiWeightVolInput    = input.float(0.20, "Weight: Volatility Regime", minval = 0.0, maxval = 1.0, step = 0.05, group = G_TQI)
tqiWeightStructInput = input.float(0.25, "Weight: Structure", minval = 0.0, maxval = 1.0, step = 0.05, group = G_TQI)
tqiWeightMomInput    = input.float(0.20, "Weight: Momentum Persist", minval = 0.0, maxval = 1.0, step = 0.05, group = G_TQI)
tqiStructLenInput    = input.int(20, "Structure Window", minval = 5, maxval = 100, group = G_TQI)
tqiMomLenInput       = input.int(10, "Momentum Persist Window", minval = 3, maxval = 50, group = G_TQI)

useStructureInput = input.bool(true, "Use Structure in Score", group = G_TQI)
pivotLenInput     = input.int(3, "Pivot Strength", minval = 2, maxval = 10, group = G_TQI)
useRsiScoreInput  = input.bool(true, "Use VWRSI in Score", group = G_TQI)
useVolScoreInput  = input.bool(true, "Use Volume in Score", group = G_TQI)
volLenInput       = input.int(20, "Volume Z Window", minval = 5, maxval = 100, group = G_TQI)

// ============================================================================
// INPUTS - ADAPTIVE
// ============================================================================
useAdaptiveInput    = input.bool(true, "Enable Vol-Adaptive Bands (legacy ER)", group = G_ADAPT)
erLengthInput       = input.int(20, "Efficiency Window", minval = 5, maxval = 100, group = G_ADAPT)
adaptStrengthInput  = input.float(0.5, "Adaptation Strength", minval = 0.0, maxval = 1.0, step = 0.05, group = G_ADAPT)
atrBaselineLenInput = input.int(100, "ATR Baseline Length", minval = 20, maxval = 500, group = G_ADAPT)

// ============================================================================
// INPUTS - EMA ENGINE
// ============================================================================
emaLengthInput  = input.int(10, "EMA Length", minval = 2, maxval = 200, group = G_EMA)
emaPullbackInput = input.bool(true, "Pullback Mode (else simple crossover)", group = G_EMA,
     tooltip = "ON = wait for pullback to EMA + reversal candle. OFF = raw crossover (noisy on 5m).")
emaFilterSlackInput = input.float(0.0, "EMA Filter Slack (xATR)", minval = 0.0, maxval = 2.0, step = 0.1, group = G_EMA,
     tooltip = "When EMA acts as a filter, how far price may sit on the wrong side of the EMA and still pass.")

// ============================================================================
// INPUTS - RISK
// ============================================================================
slAtrMultInput   = input.float(1.5, "SL Buffer (xATR)", minval = 0.3, maxval = 5.0, step = 0.1, group = G_RISK)
slMaxDistInput   = input.float(4.0, "Max SL Distance (xATR)", minval = 1.0, maxval = 15.0, step = 0.5, group = G_RISK)
tpModeInput      = input.string("Dynamic", "TP Mode", options = ["Fixed", "Dynamic"], group = G_RISK,
     tooltip = "Default changed to Dynamic. Fixed R-multiples on a high-volatility name means targets are either unreachable or trivially blown through.")
tp1RInput        = input.float(1.0, "TP1 (R-multiple)", minval = 0.5, maxval = 10.0, step = 0.1, group = G_RISK)
tp2RInput        = input.float(2.0, "TP2 (R-multiple)", minval = 0.5, maxval = 10.0, step = 0.1, group = G_RISK)
tp3RInput        = input.float(3.0, "TP3 (R-multiple)", minval = 0.5, maxval = 10.0, step = 0.1, group = G_RISK)
useTrailInput    = input.bool(true, "Trail stop to SuperTrend line after TP1", group = G_RISK,
     tooltip = "Replaces the removed Chandelier Exit. Once TP1 is banked the stop follows the adaptive band instead of sitting at the original SL.")
useBeInput       = input.bool(true, "Move stop to breakeven after TP1", group = G_RISK)
tradeMaxAgeInput = input.int(100, "Trade Timeout (bars)", minval = 10, maxval = 500, group = G_RISK)

dynTpTqiWeightInput = input.float(0.6, "TQI Influence on TP", minval = 0.0, maxval = 1.0, step = 0.05, group = G_DYNTP)
dynTpVolWeightInput = input.float(0.4, "Volatility Influence on TP", minval = 0.0, maxval = 1.0, step = 0.05, group = G_DYNTP)
dynTpMinScaleInput  = input.float(0.5, "Min TP Scale", minval = 0.2, maxval = 1.0, step = 0.05, group = G_DYNTP)
dynTpMaxScaleInput  = input.float(2.0, "Max TP Scale", minval = 1.0, maxval = 4.0, step = 0.1, group = G_DYNTP)
dynTpFloorR1Input   = input.float(0.5, "TP1 Absolute Floor (R)", minval = 0.2, maxval = 2.0, step = 0.1, group = G_DYNTP)
dynTpCeilR3Input    = input.float(8.0, "TP Absolute Ceiling (R)", minval = 2.0, maxval = 20.0, step = 0.5, group = G_DYNTP)

// ============================================================================
// INPUTS - TAKE PROFIT PLANNER
// Decision layer ported from "Take Profit Planner [AGPro Series]" v1.4.
// It does NOT build its own ladder, stop, ATR, pivots or trend model - it
// reads the plan this strategy already produced. When flat it scores the
// hypothetical trade you would get if you entered right now.
// ============================================================================
showPlannerInput      = input.bool(true, "Enable TP Planner", group = G_TPP)
plannerSensInput      = input.string("Balanced", "Sensitivity", options = ["Conservative", "Balanced", "Reactive"], group = G_TPP,
     tooltip = "Conservative demands a cleaner path before calling a target Ready. Reactive reacts faster.")
obstructLookbackInput = input.int(80, "Obstruction Lookback", minval = 10, maxval = 300, group = G_TPP,
     tooltip = "Bars searched for a prior swing sitting between price and the nearest unhit target.")
tagBufferAtrInput     = input.float(0.20, "Tagged Target Buffer (xATR)", minval = 0.02, maxval = 1.50, step = 0.01, group = G_TPP)
minTargetAtrInput     = input.float(0.65, "Minimum Useful Target (xATR)", minval = 0.10, maxval = 5.00, step = 0.05, group = G_TPP)
idealTargetAtrInput   = input.float(2.40, "Ideal Target Distance (xATR)", minval = 0.30, maxval = 10.00, step = 0.05, group = G_TPP)
maxTargetAtrInput     = input.float(6.50, "Maximum Practical Target (xATR)", minval = 1.00, maxval = 20.00, step = 0.10, group = G_TPP)
hotVolRatioInput      = input.float(2.25, "Hot Volatility Ratio", minval = 1.10, maxval = 5.00, step = 0.05, group = G_TPP)
readyThresholdInput   = input.int(72, "Target Ready Threshold", minval = 45, maxval = 95, group = G_TPP)
watchThresholdInput   = input.int(54, "Monitor Threshold", minval = 20, maxval = 90, group = G_TPP)

gateQualityInput      = input.bool(true, "Gate entries on Target Quality", inline = "gq", group = G_TPP,
     tooltip = "Blocks a new entry when the planner rates the prospective target path below the Monitor threshold - i.e. it would say 'Wait For Cleaner Path'.")
gateQualityMinInput   = input.int(54, "", minval = 0, maxval = 100, inline = "gq", group = G_TPP)
gateObstructInput     = input.bool(true, "Block entries with an obstruction in the path", group = G_TPP)
gateProofInput        = input.bool(false, "Gate on measured proof rate", inline = "gp", group = G_TPP,
     tooltip = "Once enough trades have resolved, stop entering when the share reaching TP1 before the stop falls below this.")
gateProofMinInput     = input.int(40, "", minval = 0, maxval = 100, inline = "gp", group = G_TPP)
proofMinSampleInput   = input.int(6, "Min resolved trades before proof applies", minval = 3, maxval = 50, group = G_TPP)

// ---- target engine: direction, anchor, invalidation ----
// Pivot / ATR / baseline / trend context lengths are NOT duplicated here - the
// planner reads the ones the strategy already resolved (pivotLenInput,
// effectiveAtrLen, atrBaselineLenInput, tqiStructLenInput) so there is one
// source of truth per measurement.
planDirInput          = input.string("Auto", "Plan Direction", options = ["Auto", "Long", "Short"], group = G_TPP,
     tooltip = "Auto follows the SuperTrend regime. Long/Short force the prospective plan to one side so you can score the trade you are actually considering. A live trade always keeps its own direction.")
planCalcModeInput     = input.string("Auto - Strategy SL", "Calculation Mode", options = ["Auto - Strategy SL", "Hybrid (ATR + Structure)", "ATR Only", "Structure Only", "Manual"], group = G_TPP,
     tooltip = "How the prospective invalidation is built. Auto reproduces the strategy's own SL logic (default, behaviour unchanged). Hybrid takes whichever of the distance stop and the structure stop sits further from the anchor. ATR Only uses the distance metric alone, Structure Only uses the swing alone, Manual uses Manual Invalidation Price.")
anchorSrcInput        = input.string("Auto - Pivot", "Anchor Source", options = ["Auto - Pivot", "Close", "Session Open", "Manual"], group = G_TPP,
     tooltip = "Where the entry reference comes from. Auto - Pivot anchors entry at the close and measures structure from the last pivot. Manual uses Manual Entry Price plus Manual Swing / Origin Price, and takes precedence over a live trade so you can score a level you have not entered yet.")

// ---- anchor and invalidation ----
manualEntryInput      = input.float(0.0, "Manual Entry Price", minval = 0.0, step = 0.01, group = G_TPP,
     tooltip = "Used only when Anchor Source is Manual. 0 disables.")
manualOriginInput     = input.float(0.0, "Manual Swing / Origin Price", minval = 0.0, step = 0.01, group = G_TPP,
     tooltip = "The swing the move started from. Replaces the auto pivot as the structure reference in every calculation mode. 0 disables.")
manualInvalidInput    = input.float(0.0, "Manual Invalidation Price", minval = 0.0, step = 0.01, group = G_TPP,
     tooltip = "Used only when Calculation Mode is Manual. 0 disables and falls back to the strategy SL. A manual invalidation is not distance-capped.")
autoInvalidModeInput  = input.string("ATR Multiple", "Auto Invalidation Mode", options = ["ATR Multiple", "Fixed Percent"], group = G_TPP,
     tooltip = "The distance metric used by the Hybrid and ATR Only calculation modes.")
invalidAtrMultInput   = input.float(1.8, "ATR Multiple", minval = 0.1, maxval = 10.0, step = 0.1, group = G_TPP)
invalidPctInput       = input.float(1.5, "Fixed Percent", minval = 0.05, maxval = 25.0, step = 0.05, group = G_TPP)

// ---- projected ladder visual ----
showLadderInput       = input.bool(true, "Draw Projected TP Ladder", group = G_TPP,
     tooltip = "Draws the entry reference, invalidation and the full TP ladder projected to the right of price - visible whether a trade is open or you are flat.")
plannerTiersInput     = input.int(5, "Ladder Tiers to Display", minval = 3, maxval = 7, group = G_TPP,
     tooltip = "TP1-TP3 are the tiers this strategy actually scales out of. TP4-TP7 are planning-only extensions shown for target context; no orders are placed at them.")
tp4RInput             = input.float(5.0,  "TP4 R (planning only)", minval = 0.1, step = 0.1, group = G_TPP)
tp5RInput             = input.float(8.0,  "TP5 R (planning only)", minval = 0.1, step = 0.1, group = G_TPP)
tp6RInput             = input.float(13.0, "TP6 R (planning only)", minval = 0.1, step = 0.1, group = G_TPP)
tp7RInput             = input.float(21.0, "TP7 R (planning only)", minval = 0.1, step = 0.1, group = G_TPP)
zoneWidthAtrInput     = input.float(0.24, "TP Zone Half-Width (xATR)", minval = 0.03, maxval = 2.00, step = 0.01, group = G_TPP)
projectionBarsInput   = input.int(54, "Projection Bars", minval = 12, maxval = 240, group = G_TPP)
zoneTranspInput       = input.int(88, "Zone Transparency", minval = 70, maxval = 96, group = G_TPP)
showLadderLabelsInput = input.bool(true, "Show Ladder Labels", group = G_TPP)
showPlanMarkerInput   = input.bool(true, "Mark Plan-State Changes On Chart", group = G_TPP,
     tooltip = "Prints a bubble on the bar where the planner state flips (TARGET READY, BLOCKED, INVALID REVIEW, ...) with the target-quality score at that moment.")
planMarkerKeepInput   = input.int(12, "Plan-State Markers to Keep", minval = 1, maxval = 100, group = G_TPP)

// ============================================================================
// INPUTS - LEARNING
// ============================================================================
useAutoCalibInput  = input.bool(false, "Enable Auto-Calibration (experimental)", group = G_LEARN)
calibWindowInput   = input.int(20, "Calibration Window", minval = 5, maxval = 100, group = G_LEARN)
calibBadRInput     = input.float(0.0, "Bad-Edge Threshold (R)", minval = -2.0, maxval = 1.0, step = 0.1, group = G_LEARN)
calibGoodRInput    = input.float(0.7, "Good-Edge Threshold (R)", minval = 0.0, maxval = 5.0, step = 0.1, group = G_LEARN)
calibStepQInput    = input.float(0.05, "Quality Step", minval = 0.01, maxval = 0.3, step = 0.01, group = G_LEARN)
calibCooldownInput = input.int(5, "Calibration Cooldown (signals)", minval = 1, maxval = 50, group = G_LEARN)
calibMinQInput     = input.float(0.1, "Quality Floor", minval = 0.0, maxval = 1.0, step = 0.05, group = G_LEARN)
calibMaxQInput     = input.float(0.9, "Quality Ceiling", minval = 0.0, maxval = 1.0, step = 0.05, group = G_LEARN)

// ============================================================================
// INPUTS - VISUAL / DASH / ALERT / COLORS
// ============================================================================
themeInput          = input.string("Auto", "Theme", options = ["Auto", "Dark", "Light"], group = G_VISUAL)
showBandsInput      = input.bool(true,  "Show SuperTrend Bands", group = G_VISUAL)
